<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TransitLab.ViewModels"
        xmlns:tabs="using:TransitLab.Views.Tabs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="960"
        x:Class="TransitLab.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/TransitLab.ico"
        Title="{Binding Title}"
        Width="1400" Height="960"
        MinWidth="1280" MinHeight="760">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>

        <!-- ── Menu bar ─────────────────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Load previous inits.json…"
                          Command="{Binding LoadInitsCommand}"/>
                <MenuItem Header="Save inits.json Only"
                          Command="{Binding SaveInitsOnlyCommand}"/>
                <Separator/>
                <MenuItem Header="Import AAVSO Report (-pre)…"
                          Command="{Binding ImportAavsoReportCommand}"/>
                <Separator/>
                <MenuItem Header="Recent Sessions"
                          x:Name="MenuRecentSessions"
                          Click="OnRecentSessionsMenuClick"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Clear All Fields"
                          Command="{Binding ClearAllFieldsCommand}"/>
                <Separator/>
                <MenuItem Header="Python &amp; EXOTIC Setup"
                          Click="OnExoticSetupClick"/>
                <MenuItem Header="Plate Solve Setup"
                          Click="OnPlateSolveSetupClick"/>
                <Separator/>
                <MenuItem Header="Settings">
                    <MenuItem Header="Notifications"
                              Click="OnNotificationsSettingsClick"/>
                    <MenuItem Header="Comp Stars"
                              Click="OnStoneSettingsClick"/>
                    <MenuItem Header="Automation"
                              Click="OnAutomationSettingsClick"/>
                    <MenuItem Header="Advanced"
                              Click="OnAdvancedSettingsClick"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Clear ldtk Cache"
                          Command="{Binding ClearLdtkCacheCommand}"/>
                <MenuItem Header="Download Full ldtk Library"
                          Click="OnDownloadLdtkLibraryClick"/>
                <Separator/>
                <MenuItem Header="Diagnostics"
                          Click="OnDiagnosticsClick"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Quick Start"
                          Click="OnQuickStartClick"/>
                <MenuItem Header="User Guide"
                          Click="OnUserGuideClick"/>
                <MenuItem Header="Revision History"
                          Click="OnRevisionHistoryClick"/>
                <Separator/>
                <MenuItem Header="Check for Updates"
                          Command="{Binding CheckForUpdatesCommand}"/>
                <MenuItem Header="Previous Versions…"
                          Click="OnPreviousVersionsClick"/>
                <Separator/>
                <MenuItem Header="Submit Feedback"
                          Click="OnBugReportClick"/>
                <Separator/>
                <MenuItem Header="About TransitLab"
                          Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <!-- ── Header banner: logo + title, bigger than just the window/taskbar icon ── -->
        <Border DockPanel.Dock="Top" Padding="16,10,16,10">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Image Source="avares://TransitLab/Assets/TransitLab_logo.png" Width="104" Height="104"/>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock Classes="title" Text="TransitLab"/>
                    <TextBlock Classes="hint" Text="Exoplanet transit photometry via EXOTIC"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Update banner: available ─────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsUpdateAvailable}"
                Background="#1a4a1a"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdateVersionText}"
                           Foreground="#90ee90"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Content="Update Now"
                        Command="{Binding SelfUpdateNowCommand}"
                        IsVisible="{Binding CanSelfUpdate}"
                        Classes="primary"
                        ToolTip.Tip="Downloads and installs the update automatically — TransitLab will close and reopen on its own."/>
                <Button Content="Download"
                        Command="{Binding DownloadUpdateCommand}"
                        Classes="toolbar"
                        ToolTip.Tip="Downloads the zip to a folder you choose — you extract and replace the app files yourself."/>
                <Button Content="Skip"
                        Command="{Binding SkipUpdateCommand}"
                        Classes="toolbar"/>
            </StackPanel>
        </Border>

        <!-- ── Update banner: downloading ───────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsUpdateDownloading}"
                Background="#1a3a4a"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdateStatusText}"
                           Foreground="#87ceeb"
                           VerticalAlignment="Center"
                           MinWidth="300"/>
                <ProgressBar Value="{Binding UpdateProgress}"
                             Maximum="100"
                             Width="200"
                             Height="8"
                             VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Update banner: done ──────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsUpdateDone}"
                Background="#1a4a1a"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdateStatusText}"
                           Foreground="#90ee90"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"/>
                <Button Content="OK"
                        Command="{Binding DismissUpdateDoneCommand}"
                        Classes="toolbar"/>
            </StackPanel>
        </Border>

        <!-- ── Separator ────────────────────────────────────────────────── -->
        <Rectangle DockPanel.Dock="Top"
                   Height="1"
                   Fill="{StaticResource BrushSep}"
                   Margin="10,8,10,0"/>

        <!-- ── Bottom attribution bar ───────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Padding="0,2,10,4">
            <TextBlock Classes="hint"
                       Text="{Binding Version, StringFormat='© Art Trail 2026  ·  TransitLab v{0}  ·  Powered by EXOTIC (Zellem, Pearson, Blaser et al. 2020, PASP 132)'}"
                       HorizontalAlignment="Right"/>
        </Border>

        <!-- ── Automation armed banner ──────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding Automation.IsArmed}"
                Background="#1a2e1a"
                Padding="0,5">
            <Border.Styles>
                <Style Selector="TextBlock.armed-flash">
                    <Style.Animations>
                        <Animation Duration="0:0:2" IterationCount="INFINITE" Easing="SineEaseInOut">
                            <KeyFrame Cue="0%">  <Setter Property="Opacity" Value="1.0"/></KeyFrame>
                            <KeyFrame Cue="50%"> <Setter Property="Opacity" Value="0.2"/></KeyFrame>
                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="14"
                        VerticalAlignment="Center">
                <TextBlock Classes="armed-flash"
                           Text="⬤  AUTOMATION ARMED"
                           Foreground="#A3BE8C"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Automation.CountdownText}"
                           Foreground="#A3BE8C"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Tab control ──────────────────────────────────────────────── -->
        <!-- Tab index: Data=0, Image Analysis=1, Parameters=2, Results=3, Visualizer=4, History=5 -->
        <TabControl x:Name="MainTabs">

            <TabItem Header="   Data   ">
                <tabs:MObsView/>
            </TabItem>

            <TabItem Header="   Image Analysis   ">
                <tabs:FrameAnalysisView DataContext="{Binding FrameAnalysis}"/>
            </TabItem>

            <TabItem Header="   Parameters   ">
                <tabs:EquipmentTargetView/>
            </TabItem>

            <TabItem Header="  Results  ">
                <tabs:ResultsView DataContext="{Binding Results}"/>
            </TabItem>

            <TabItem Header="   Visualizer   ">
                <tabs:TransitView/>
            </TabItem>

            <TabItem Header="  History  ">
                <tabs:HistoryView DataContext="{Binding History}"/>
            </TabItem>

        </TabControl>

    </DockPanel>

</Window>
