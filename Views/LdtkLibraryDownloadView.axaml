<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TransitLab.ViewModels"
             x:DataType="vm:LdtkLibraryDownloadViewModel"
             x:Class="TransitLab.Views.LdtkLibraryDownloadView">

    <DockPanel Margin="16,14,16,14">

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding HeadlineText}"
                   FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <!-- Confirm panel — shown after the mirror crawl reports the size -->
        <StackPanel DockPanel.Dock="Top"
                    IsVisible="{Binding IsConfirmVisible}"
                    Spacing="14" Margin="0,0,0,10">
            <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelConfirmCommand}" MinWidth="80"/>
                <Button Content="Download &amp; Install" Classes="primary"
                        Command="{Binding ConfirmCommand}" MinWidth="140"/>
            </StackPanel>
        </StackPanel>

        <!-- Progress + log -->
        <StackPanel DockPanel.Dock="Top"
                    IsVisible="{Binding IsProgressVisible}"
                    Spacing="8" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="{Binding IsIndeterminate}"
                         Value="{Binding ProgressValue}"
                         Maximum="{Binding ProgressMax}"
                         Height="6"/>
        </StackPanel>

        <!-- Bottom button bar -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8" Margin="0,10,0,0">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding !IsDone}"
                    IsEnabled="{Binding CanCancel}"
                    MinWidth="80"/>
            <Button Content="Close" Classes="primary"
                    Command="{Binding CloseCommand}"
                    IsVisible="{Binding IsDone}"
                    MinWidth="80"/>
        </StackPanel>

        <!-- Log -->
        <Border Background="#1A1D23"
                CornerRadius="4"
                Padding="8"
                BorderThickness="1"
                BorderBrush="#3A3F4B">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding LogText}"
                           FontFamily="Courier New"
                           FontSize="12"
                           Foreground="#ECEFF4"
                           TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Border>

    </DockPanel>

</UserControl>
