<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TransitLab.ViewModels"
             x:DataType="vm:DebayerProgressViewModel"
             x:Class="TransitLab.Views.DebayerProgressView">

    <DockPanel Margin="14,12,14,12">

        <!-- Header: status + live spinner while running -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="2,0,2,10">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#ECEFF4"
                       TextWrapping="Wrap"/>
            <ProgressBar IsIndeterminate="True"
                         Height="6"
                         IsVisible="{Binding IsRunning}"
                         Foreground="#88C0D0"
                         Background="#2E3440"/>
            <TextBlock Text="Do not close TransitLab — this window will let you know when it's done."
                       FontSize="12"
                       Foreground="#8A9BB0"
                       IsVisible="{Binding IsRunning}"/>
        </StackPanel>

        <!-- Button bar -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="OK"
                    Classes="primary"
                    Command="{Binding OkCommand}"
                    IsEnabled="{Binding IsComplete}"
                    MinWidth="90"
                    ToolTip.Tip="Enabled once debayering has finished"/>
        </StackPanel>

        <!-- Live session log -->
        <Border Background="#1A1D23"
                CornerRadius="4"
                Padding="8"
                BorderThickness="1"
                BorderBrush="#3A3F4B">
            <ListBox x:Name="LogListBox"
                     ItemsSource="{Binding LogLines}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="Courier New"
                                   FontSize="12"
                                   Foreground="#ECEFF4"
                                   TextWrapping="NoWrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="2,0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Border>

    </DockPanel>

</UserControl>
