<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TransitLab.ViewModels"
             x:DataType="vm:SettingsViewModel"
             x:Class="TransitLab.Views.SettingsView">

    <StackPanel Margin="28,24,28,20" Spacing="16" MinWidth="380">

        <!-- Sound preset row -->
        <Grid ColumnDefinitions="Auto,12,*,8,Auto">
            <TextBlock Grid.Column="0"
                       Text="Completion sound"
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding SoundPresets}"
                      SelectedItem="{Binding SelectedSound}"/>
            <Button Grid.Column="4"
                    Content="Test"
                    Command="{Binding TestSoundCommand}"
                    MinWidth="56"/>
        </Grid>

        <!-- Custom file row — visible only when "Custom…" is selected -->
        <Grid ColumnDefinitions="*,8,Auto"
              IsVisible="{Binding IsCustom}">
            <TextBox Grid.Column="0"
                     Text="{Binding CustomSoundPath}"
                     Watermark="Path to sound file (WAV, MP3)…"
                     IsReadOnly="True"/>
            <Button Grid.Column="2"
                    Content="Browse…"
                    Command="{Binding BrowseSoundCommand}"
                    MinWidth="80"/>
        </Grid>

        <!-- Operation status alerts toggle -->
        <Grid ColumnDefinitions="*,12,Auto">
            <TextBlock Grid.Column="0"
                       Text="Operation status alerts"
                       VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="2"
                          IsChecked="{Binding StatusAlertsEnabled}"
                          OnContent="Enabled" OffContent="Disabled"
                          VerticalAlignment="Center"/>
        </Grid>

        <!-- Show tips at startup toggle -->
        <Grid ColumnDefinitions="*,12,Auto">
            <TextBlock Grid.Column="0"
                       Text="Show tips at startup"
                       VerticalAlignment="Center"/>
            <ToggleSwitch Grid.Column="2"
                          IsChecked="{Binding ShowTipsAtStartup}"
                          OnContent="Enabled" OffContent="Disabled"
                          VerticalAlignment="Center"/>
        </Grid>

        <Rectangle Height="1" Fill="{StaticResource BrushSep}" Margin="0,4,0,0"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    MinWidth="80"/>
            <Button Content="Save"
                    Classes="primary"
                    Command="{Binding SaveCommand}"
                    MinWidth="80"/>
        </StackPanel>

    </StackPanel>

</UserControl>
