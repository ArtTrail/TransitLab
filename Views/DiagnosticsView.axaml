<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TransitLab.ViewModels"
             x:DataType="vm:DiagnosticsViewModel"
             x:Class="TransitLab.Views.DiagnosticsView">

    <DockPanel Margin="12,10,12,10">

        <!-- Button bar -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,8,0,0">
            <ToggleButton Classes="toolbar"
                          Content="⏸ Pause"
                          IsChecked="{Binding IsLogFrozen}"
                          ToolTip.Tip="Pause auto-scroll so you can read the log"/>
            <Button Content="Save Log"
                    Classes="primary"
                    Command="{Binding SaveLogCommand}"
                    MinWidth="80"/>
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    MinWidth="80"/>
        </StackPanel>

        <!-- Log list -->
        <Border Background="#1A1D23"
                CornerRadius="4"
                Padding="8"
                BorderThickness="1"
                BorderBrush="#3A3F4B">
            <ListBox x:Name="LogListBox"
                     ItemsSource="{Binding LogLines}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="Courier New"
                                   FontSize="12"
                                   Foreground="#ECEFF4"
                                   TextWrapping="NoWrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="2,0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Border>

    </DockPanel>

</UserControl>
