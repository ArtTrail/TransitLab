<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TransitLab.Views.QuickStartView">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="0" Margin="36,24,36,28">

            <TextBlock Classes="title" Text="Quick Start" HorizontalAlignment="Left" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Classes="hint"
                       Text="Follow these steps in order. Most fields are filled automatically — click the bold buttons to let TransitLab do the work."
                       Margin="0,0,0,20"/>

            <!-- Step 1 -->
            <TextBlock Classes="h2" Text="Step 1 — Set your FITS directory  (Data tab)" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Margin="16,0,0,0"
                       Text="On the Data tab, click Browse next to Lights Directory and select the folder containing your science images."/>
            <TextBlock TextWrapping="Wrap" Margin="16,4,0,12" Classes="hint"
                       Text="Save Plots, Darks, Flats, and Biases directories are detected automatically. You can override them by browsing manually."/>

            <!-- Step 2 -->
            <TextBlock Classes="h2" Text="Step 2 — Check frames  (Image Analysis tab)" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Margin="16,0,0,0"
                       Text="Go to the Image Analysis tab. Click Scan Files to measure background levels and flag any frames with unusually high background (clouds, moon, etc.)."/>
            <TextBlock TextWrapping="Wrap" Margin="16,4,0,0"
                       Text="Flagged frames are shown with 'Flagged' in the Status column but are NOT automatically excluded. To exclude them, click Exclude Flagged — or check individual Excl boxes manually. Restore Excluded un-checks them all if you change your mind."/>
            <TextBlock TextWrapping="Wrap" Margin="16,4,0,12" Classes="hint"
                       Text="Tip: adjust the σ threshold (default 3.0) to control how aggressively frames are flagged."/>

            <!-- Step 3 -->
            <TextBlock Classes="h2" Text="Step 3 — Read the FITS header  (Parameters tab)" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Margin="16,0,0,0"
                       Text="Go to the Parameters tab and click Read FITS Header. This reads the first image in the directory and automatically fills in:"/>
            <TextBlock TextWrapping="Wrap" Margin="32,4,0,2" Text="• Observation date, site latitude/longitude, and elevation"/>
            <TextBlock TextWrapping="Wrap" Margin="32,0,0,2" Text="• Camera filter, pixel binning, and pixel scale"/>
            <TextBlock TextWrapping="Wrap" Margin="32,0,0,2" Text="• Planet name (from the OBJECT header keyword)"/>
            <TextBlock TextWrapping="Wrap" Margin="32,0,0,12" Text="• Plate solve (runs in the background — look for the status under Plate Solve: ✓ green means fully solved, ⚠ yellow means partially solved but still usable, ✗ red means it failed and needs attention)"/>

            <!-- Step 4 -->
            <TextBlock Classes="h2" Text="Step 4 — Fetch planet parameters  (Parameters tab)" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Margin="16,0,0,0"
                       Text="The planet name found in the FITS header triggers an automatic NASA Exoplanet Archive (NEA) fetch. Wait for the ✓ status to appear next to Fetch from NEA on the right side of the Parameters tab."/>
            <TextBlock TextWrapping="Wrap" Margin="16,4,0,0" Classes="hint"
                       Text="If the planet name is wrong or the fetch fails, type the correct name (e.g. HAT-P-36 b) and click Fetch from NEA manually."/>
            <TextBlock TextWrapping="Wrap" Margin="16,4,0,12" Classes="hint"
                       Text="Review the filled-in values — especially Rp/Rs, Teff, and Metallicity — before running."/>

            <!-- Step 5 -->
            <TextBlock Classes="h2" Text="Step 5 — Select comparison and target stars  (Parameters tab)" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Margin="16,0,0,0"
                       Text="Return to the Parameters tab. Under Star Selection, choose a Comp star method — AAVSO VSP (fast, uses the published AAVSO sequence, default), VSP + Stone (recommended: full Gaia/APASS/GSPC pipeline with VSP priority fill), or Stone (same pipeline without VSP) — then click Fetch Comps."/>
            <TextBlock TextWrapping="Wrap" Margin="16,4,0,2" Classes="hint"
                       Text="Stone methods run PSF validation and show an Image Quality summary (FWHM, color match, precision, PSF grade) when the fetch completes. Click ⊞ Comp Details for a full per-star breakdown."/>
            <TextBlock TextWrapping="Wrap" Margin="16,4,0,2"
                       Text="Still need more comps? Go to Image Analysis, enable Pick Comp Stars, click stars in the image, then Send to Comp Stars."/>
            <TextBlock TextWrapping="Wrap" Margin="16,4,0,2"
                       Text="To set the target position, click Auto Select Target (requires a plate solution and planet RA/Dec to be filled in)."/>
            <TextBlock TextWrapping="Wrap" Margin="16,0,0,12"
                       Text="If that is unavailable, go to Image Analysis, click Pick Target Star, click the star in the image, then click Send to Target Star."/>

            <!-- Step 6 -->
            <TextBlock Classes="h2" Text="Step 6 — Confirm observer details  (Parameters tab)" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Margin="16,0,0,0"
                       Text="Under Observer Information, confirm your AAVSO Observer Code is entered. Under Observatory / Location, confirm latitude, longitude, and elevation."/>
            <TextBlock TextWrapping="Wrap" Margin="16,4,0,12" Classes="hint"
                       Text="Select Observatory auto-fills lat/lon/elevation from a location you've saved before. First time at a new site? Fill in the coordinates, then click Save current as to name and store it for future sessions."/>

            <!-- Step 7 -->
            <TextBlock Classes="h2" Text="Step 7 — Run EXOTIC" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Margin="16,0,0,0"
                       Text="Click Save &amp; Run EXOTIC at the top of the window. TransitLab saves an inits.json file, moves any excluded frames aside, launches EXOTIC, and switches to the Results tab where you can watch the live log."/>
            <TextBlock TextWrapping="Wrap" Margin="16,4,0,12" Classes="hint"
                       Text="When EXOTIC finishes, the light curve plot appears in the Results tab. Use Export CSV or Export XLSX in the History tab to save your results."/>

            <!-- Separator -->
            <Rectangle Height="1" Fill="{StaticResource BrushSep}" Margin="0,8,0,12"/>

            <!-- Tips -->
            <TextBlock Classes="h2" Text="Tips" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                       Text="• If the plate solve fails, try Retry under Plate Solve on the Parameters tab, or switch solvers in Tools → Plate Solve Setup — StarFix (offline Gaia DR3, no internet required) or ASTAP for faster local solving. MicroObservatory and Unistellar eVscope frames in particular can struggle with ASTAP; StarFix or Astrometry.net are the recommended alternatives."/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                       Text="• Python &amp; EXOTIC Setup (Tools menu) lets you locate or install Python and EXOTIC if they are not found automatically — including separate Stable and Pre-release environments."/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                       Text="• Use File → Recent Sessions to reload the inits.json from a previous run and re-run with the same settings."/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                       Text="• MicroObservatory users: use the MObs section in the Data tab to fetch and download telescope data directly — then click Use This Data to populate the directories automatically. Data refreshes once daily (13:00 UTC), not live."/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                       Text="• Running the EXOTIC 4.3.2 pre-release build? Quick Look (top bar, next to Save &amp; Run EXOTIC) runs a fast least-squares fit for a quick preliminary look at the light curve, using the same directories and star selections — no AAVSO report is produced, so it's for previewing only, not submitting."/>

        </StackPanel>
    </ScrollViewer>

</UserControl>
