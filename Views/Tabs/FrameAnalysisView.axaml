<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TransitLab.ViewModels"
             xmlns:controls="using:TransitLab.Views.Controls"
             x:Class="TransitLab.Views.Tabs.FrameAnalysisView"
             x:DataType="vm:FrameAnalysisViewModel">

    <DockPanel Margin="10,8,10,8">

        <!-- ── Row 1: Scan controls ─────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,4">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="[?]" FontSize="12" Padding="3,0"
                            VerticalAlignment="Center" Click="OnHelpImageAnalysis_Click"/>
                    <Button Classes="primary"
                            Content="Scan Files"
                            Command="{Binding ScanFilesCommand}"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Flag" VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding FlagSigma}"
                                  Minimum="1" Maximum="10" Increment="0.5"
                                  FormatString="0.0" Width="120"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="σ above median" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding ScanStatus}"
                           Classes="hint"
                           Foreground="{Binding ScanStatus, Converter={StaticResource StatusBrushConverter}}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="3"
                        Classes="toolbar" Content="Exclude Flagged"
                        Command="{Binding AutoExcludeFlaggedCommand}"
                        VerticalAlignment="Center" Margin="8,0,0,0"/>

                <Button Grid.Column="4"
                        Classes="toolbar" Content="Restore Excluded"
                        Command="{Binding RestoreExcludedCommand}"
                        VerticalAlignment="Center" Margin="8,0,0,0"/>

            </Grid>
        </Border>

        <!-- ── Row 2: VSP controls ───────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,6">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                <TextBlock Text="FOV'" VerticalAlignment="Center"/>
                <NumericUpDown Value="{Binding VspFov}"
                               Minimum="10" Maximum="360" Increment="10"
                               FormatString="0" Width="130"
                               VerticalAlignment="Center"/>

                <TextBlock Text="Mag" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <NumericUpDown Value="{Binding VspMag}"
                               Minimum="8" Maximum="20" Increment="0.5"
                               FormatString="0.0" Width="145"
                               VerticalAlignment="Center"/>

                <TextBlock Text="N" VerticalAlignment="Center" Margin="12,0,0,0"
                           ToolTip.Tip="North direction: 'up' = North at top of chart, 'down' = North at bottom"/>
                <ComboBox ItemsSource="{Binding VspNorthOptions}"
                          SelectedItem="{Binding VspNorth}"
                          Width="78"
                          VerticalAlignment="Center"
                          ToolTip.Tip="North direction: 'up' = North at top of chart, 'down' = North at bottom"/>

                <TextBlock Text="E" VerticalAlignment="Center" Margin="8,0,0,0"
                           ToolTip.Tip="East direction: 'left' = East at left of chart, 'right' = East at right"/>
                <ComboBox ItemsSource="{Binding VspEastOptions}"
                          SelectedItem="{Binding VspEast}"
                          Width="78"
                          VerticalAlignment="Center"
                          ToolTip.Tip="East direction: 'left' = East at left of chart, 'right' = East at right"/>

                <TextBlock Text="Star:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox Text="{Binding VspStar}"
                         Watermark="e.g. HAT-P-36"
                         Width="220"
                         VerticalAlignment="Center"
                         ToolTip.Tip="Host star name for the AAVSO VSP chart lookup. Auto-fills from NEA."/>

                <Button Classes="toolbar"
                        Content="{Binding VspButtonLabel}"
                        Command="{Binding ShowVspCommand}"
                        IsEnabled="{Binding !IsVspLoading}"
                        VerticalAlignment="Center"/>

                <Button Classes="toolbar" Content="Cancel"
                        Command="{Binding CancelVspCommand}"
                        IsVisible="{Binding IsVspLoading}"
                        VerticalAlignment="Center"/>

            </StackPanel>
        </Border>

        <!-- ── Exclusion row ────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,6">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding ExclusionStatus}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FlaggedStatus}"
                           Foreground="{Binding FlaggedStatus, Converter={StaticResource StatusBrushConverter}}"
                           VerticalAlignment="Center"/>
                <CheckBox Content="Dark-subtract before background estimate"
                          IsChecked="{Binding IsDarkSubtract}"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Separator ────────────────────────────────────────────────────── -->
        <Rectangle DockPanel.Dock="Top"
                   Height="1"
                   Fill="{StaticResource BrushSep}"
                   Margin="0,0,0,6"/>

        <!-- ── Main paned area ──────────────────────────────────────────────── -->
        <Grid ColumnDefinitions="*,Auto,*">

            <!-- ── LEFT: frame list ─────────────────────────────────────────── -->
            <DockPanel Grid.Column="0">

                <DataGrid x:Name="FrameGrid"
                          x:CompileBindings="False"
                          ItemsSource="{Binding Frames}"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent"
                          RowBackground="Transparent"
                          SelectionMode="Extended">

                    <DataGrid.Columns>
                        <!-- Excl column: DataGridTemplateColumn so the CheckBox's Click handler
                             can propagate the toggle to all selected rows when the user has
                             shift-clicked a range. CheckBox.PointerPressed is marked Handled by
                             the Button base class, so the DataGrid's row-selection logic never
                             sees it and the multi-row selection is preserved. -->
                        <DataGridTemplateColumn Header="Excl" Width="80" SortMemberPath="IsExcluded">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsExcluded, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Click="OnExclCheckBoxClick"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn     Header="Filename"   Binding="{Binding Filename}"   Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn    Header="Background" Binding="{Binding Background}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn    Header="Status"     Binding="{Binding Status}"     Width="100" IsReadOnly="True"/>
                    </DataGrid.Columns>

                </DataGrid>
            </DockPanel>

            <!-- ── GridSplitter ─────────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          ResizeDirection="Columns"
                          Background="{StaticResource BrushSep}"/>

            <!-- ── RIGHT: image viewer + controls ──────────────────────────── -->
            <Grid Grid.Column="2" Margin="6,0,0,0">

                <controls:FrameViewerControl x:Name="Viewer"/>

                <!-- Shown in place of the viewer while it's popped out into its own window -->
                <Border x:Name="PoppedOutPlaceholder"
                        Background="{StaticResource BrushBg2}"
                        CornerRadius="4"
                        IsVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Classes="hint"
                                   Text="Image popped out into a separate window."
                                   HorizontalAlignment="Center"/>
                        <Button Classes="toolbar"
                                Content="Bring Back"
                                Click="OnBringBackClick"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </Grid>

        </Grid>

    </DockPanel>

</UserControl>
