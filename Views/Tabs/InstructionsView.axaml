<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TransitLab.Views.Tabs.InstructionsView">

    <UserControl.Styles>
        <Style Selector="Button.link">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource BrushAccent}"/>
            <Setter Property="FontFamily"      Value="Arial"/>
            <Setter Property="FontSize"        Value="20"/>
            <Setter Property="Padding"         Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource BrushBtnHov}"/>
        </Style>
    </UserControl.Styles>

    <Grid>
    <ScrollViewer x:Name="Scroller"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">

        <StackPanel x:Name="ContentPanel" Spacing="6" Margin="32,20,32,24">

            <TextBlock Classes="title" Text="TransitLab User Guide"/>

            <!-- ── Search ────────────────────────────────────────────────────── -->
            <Border Background="{StaticResource BrushBg2}"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="0,0,0,4">
                <DockPanel>
                    <TextBlock x:Name="SearchStatus"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushHint}"
                               FontSize="18"
                               Margin="10,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="Clear"
                            Click="SearchClear_Click"
                            Padding="12,4" Margin="6,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="Find Next"
                            Click="FindNext_Click"
                            Padding="12,4" Margin="6,0,0,0"/>
                    <TextBox x:Name="SearchBox"
                             Watermark="Search guide…"
                             KeyDown="SearchBox_KeyDown"/>
                </DockPanel>
            </Border>

            <!-- ── Table of Contents ──────────────────────────────────────────── -->
            <TextBlock Classes="h2" Text="Table of Contents" Margin="0,0,0,4"/>
            <Border Background="{StaticResource BrushBg2}"
                    CornerRadius="4"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <StackPanel Spacing="6">
                    <Button Classes="link" Tag="Sec1"    Click="TocClick">1.  Data tab  (Directories + MicroObservatory)</Button>
                    <Button Classes="link" Tag="Sec2"    Click="TocClick">2.  Parameters tab</Button>
                    <Button Classes="link" Tag="Sec3"    Click="TocClick">3.  Parameters tab — Planet Parameters</Button>
                    <Button Classes="link" Tag="Sec4"    Click="TocClick">4.  Image Analysis tab</Button>
                    <Button Classes="link" Tag="SecVis"  Click="TocClick">5.  Visualizer tab</Button>
                    <Button Classes="link" Tag="Sec5"    Click="TocClick">6.  Menu Bar</Button>
                    <Button Classes="link" Tag="Sec6"    Click="TocClick">7.  Save &amp; Run EXOTIC</Button>
                    <Button Classes="link" Tag="Sec7"    Click="TocClick">8.  Results tab</Button>
                    <Button Classes="link" Tag="Sec8"    Click="TocClick">9.  History tab</Button>
                    <Button Classes="link" Tag="Sec9"    Click="TocClick">10.  Python &amp; EXOTIC Setup  (Tools → Python &amp; EXOTIC Setup)</Button>
                    <Button Classes="link" Tag="Sec10"   Click="TocClick">11.  Plate Solve Setup  (Tools → Plate Solve Setup)</Button>
                    <Button Classes="link" Tag="Sec11"   Click="TocClick">12.  Settings  (Tools → Settings)</Button>
                    <Button Classes="link" Tag="Sec11a"  Click="TocClick">13.  Notifications</Button>
                    <Button Classes="link" Tag="Sec11b"  Click="TocClick">14.  Automation</Button>
                    <Button Classes="link" Tag="Sec12"   Click="TocClick">15.  Diagnostics  (Tools → Diagnostics)</Button>
                    <Button Classes="link" Tag="Sec13"   Click="TocClick">16.  Previous Versions  (Help → Previous Versions)</Button>
                    <Button Classes="link" Tag="Sec14"   Click="TocClick">17.  Submit Feedback  (Help → Submit Feedback)</Button>
                    <Button Classes="link" Tag="SecTips" Click="TocClick">Tips</Button>
                    <Button Classes="link" Tag="SecAppA" Click="TocClick">Appendix — Filter Wavelength Reference Sources</Button>
                    <Button Classes="link" Tag="SecRefs" Click="TocClick">References</Button>
                </StackPanel>
            </Border>

            <!-- ── 1. Data tab ──────────────────────────────────────────────── -->
            <TextBlock x:Name="Sec1" Classes="h2" Text="1.  Data tab  (Directories + MicroObservatory)" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• The Data tab has two sections: Directories at the top (where you set your Lights, Darks, Flats, Biases, and Save Plots directories), and MicroObservatory (MObs) below — for downloading FITS data directly from the MicroObservatory telescope network."/>
            <TextBlock TextWrapping="Wrap" Text="• MObs data is mirrored to TransitLab once daily at 13:00 UTC rather than live, so TransitLab isn't querying MicroObservatory's own servers directly on every request. If a session finishes after today's 13:00 UTC refresh, it won't show up in Fetch List until tomorrow's."/>
            <TextBlock TextWrapping="Wrap" Text="• Supported file types: .fits, .fit, and .fz (Rice/GZIP tile-compressed FITS, as produced by fpack) — .fz files are decompressed automatically wherever TransitLab reads FITS data (Image Analysis, dark frame loading, plate solving, header reads). No manual funpack step is needed."/>
            <TextBlock TextWrapping="Wrap" Text="• One-shot-color (OSC) camera detection: as soon as a Lights, Darks, Flats, or Biases directory is set, TransitLab checks whether the FITS files are raw color-camera data (a Bayer-pattern header, e.g. from a Unistellar eVscope) — this data needs to be debayered before Image Analysis, Plate Solve, or comp star selection, since running those on the raw mosaic distorts star detection and photometry. If detected, a prompt offers to debayer the affected directories automatically; declining leaves everything as-is, and that same directory can still be detected and prompted again later — Skip doesn't silence it permanently. Debayering extracts the green channel (the sharpest, most sensitive channel in a Bayer sensor) and writes the result to a new 'Debayered' subfolder next to the original — your raw files are never modified or deleted. TransitLab then switches to the debayered files and re-scans automatically, so you can go straight to Image Analysis or Plate Solve. A progress bar on the Data tab shows the debayering progress; for a small number of frames this may complete in a second or two."/>
            <TextBlock TextWrapping="Wrap" Text="• Each Save &amp; Run writes into its own subfolder of the Save Plots directory, named '{Target Name}_{Obs Date}_Results{n}_{EXOTIC version}' (e.g. 'KELT-8 b_29-JUN-2026_Results1_4.3.1') rather than overwriting the previous run's output. {n} counts how many times that exact target + date has already been run (across any EXOTIC version), so re-running the same night's data is always kept side by side instead of replacing it. inits.json for that run is saved in the same subfolder."/>
            <TextBlock TextWrapping="Wrap" Text="• Set your Download Directory and check 'Set as default' to remember it. A target subdirectory is created automatically inside the download directory."/>
            <TextBlock TextWrapping="Wrap" Text="• Set Lookback days and click Fetch List to retrieve recent observations from the Cecilia telescope. Columns are sortable by clicking the header."/>
            <TextBlock TextWrapping="Wrap" Text="• Select an observation and click Download Selected. Science frames go into the target subfolder; dark calibration frames go into a Darks subfolder."/>
            <TextBlock TextWrapping="Wrap" Text="• Click Use This Data to automatically populate the Lights and Darks directories and switch to the Parameters tab. Then click Read FITS Header (at the top of the Parameters tab) to fill in date, filter, binning, and planet parameters."/>
            <TextBlock TextWrapping="Wrap" Text="• Planet name is auto-formatted: 'HATP-36' → 'HAT-P-36 b',  'WASP-160B' → 'WASP-160 B b', etc." Margin="0,0,0,12"/>

            <!-- ── 2. Parameters tab ────────────────────────────────────────── -->
            <TextBlock x:Name="Sec2" Classes="h2" Text="2.  Parameters tab" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• Click Read FITS Header at the top of this tab — auto-fills date, filter, and binning (shown beside the button), plus pixel scale, observing notes, site coordinates, and planet name in the background, then fetches NEA parameters. Filter values 'C' and 'Clear' are automatically mapped to 'CV'."/>
            <TextBlock TextWrapping="Wrap" Text="• Filter Minimum/Maximum Wavelength (nm) are auto-filled from a built-in reference table keyed by filter code — but these are typical bandpass values for that filter type, not a measurement of the specific filter in your own camera. Please confirm they match your filter's actual published bandpass before running EXOTIC, and correct them manually if not. This matters most for 'Clear'/CV-type filters, which have no fixed bandpass at all — it depends entirely on your camera's own sensor response. See Appendix — Filter Wavelength Reference Sources for where these defaults come from."/>
            <TextBlock TextWrapping="Wrap" Text="• Note: directories (FITS, Save Plots, Darks, Flats, Biases) are set on the Data tab. Read FITS Header is disabled when a new FITS directory has been browsed but the header has not yet been read — the Save &amp; Run button will also be disabled until you click Read FITS Header."/>
            <TextBlock TextWrapping="Wrap" Text="• If the first FITS file is not already plate-solved, the launcher automatically starts a plate solve in the background and writes the WCS solution back — no action required. If the plate solve fails, a Retry Plate Solve button appears in the Star Selection section. Once WCS is available, the Fetch Comps button becomes active — select your preferred comparison star method from the dropdown and click Fetch Comps to retrieve comp stars. A Cancel button appears while a fetch is in progress."/>
            <TextBlock TextWrapping="Wrap" Text="• When loading a previous inits.json, the Select Observatory dropdown is auto-matched from the saved lat/lon/elevation — or set to '— custom —' if the coordinates don't match any saved observatory."/>
            <TextBlock TextWrapping="Wrap" Text="• Confirm or set your AAVSO Observer Code and observatory." Margin="0,0,0,12"/>

            <!-- ── 3. Parameters tab — Planet Parameters ─────────────────────── -->
            <TextBlock x:Name="Sec3" Classes="h2" Text="3.  Parameters tab — Planet Parameters" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• This panel (right side of Parameters tab) shows Planet Parameters: planet name and orbital/physical parameters. (Most fields are auto-filled by Read FITS Header at the top of the Parameters tab.)"/>
            <TextBlock TextWrapping="Wrap" Text="• Stellar Variability Only checkbox (top of the panel) — runs EXOTIC's stellar-variability-only reduction instead of fitting a transit model: useful for monitoring runs where no transit is expected in the data. Written to inits.json's optional_info as 'stellar_variability_only'. Requires the EXOTIC 4.3.2 pre-release dev build, build 80 or later — earlier builds do not have this mode. Checking the box shows a one-time warning that this mode should only be used on data that does not contain a transit; check 'Don't show this warning again' to dismiss it permanently."/>
            <TextBlock TextWrapping="Wrap" Text="• If your filter has no known wavelength range, you will be prompted to enter the minimum and maximum wavelengths before EXOTIC is launched."/>
            <TextBlock TextWrapping="Wrap" Text="• Planet name and parameters are auto-fetched when Read FITS Header runs. Planet names are looked up case-insensitively — 'tres-3 b' resolves to the canonical 'TrES-3 b' automatically. Click Fetch from NEA manually if you change the planet name. Review all values before running — NEA data is not always current."/>
            <TextBlock TextWrapping="Wrap" Text="• Hover any planetary parameter field for 2 seconds to see a tooltip describing the parameter, its units, and a typical value range."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="How the NEA query works: the launcher uses the same two-pass strategy as EXOTIC. The most recent publication from the per-publication table (ps, tran_flag=1) is used as the primary data source. Any fields that are null in that row are filled by scanning earlier publications in the same table. If a direct value is unavailable, Rp/Rs is computed from transit depth or planet/stellar radii, and a/Rs is computed via Kepler's third law. Missing inclination defaults to 90°, eccentricity to 0, and argument of periastron to 0 — matching EXOTIC's own fallbacks. This alignment minimises parameter differences between the launcher and EXOTIC, reducing or eliminating the mid-run review prompts."/>
            <TextBlock TextWrapping="Wrap" Margin="20,6,0,0" Text="Defaults for missing parameters: if the NEA does not report a value for one or more parameters, the launcher fills in a reasonable placeholder rather than leaving the field blank (which would block EXOTIC from running). The following defaults may be applied:"/>
            <TextBlock TextWrapping="Wrap" Margin="40,2,0,0" Text="• Rp/Rs — if the value from NEA is outside the physically plausible range for a transiting exoplanet (0.01–0.35), it is recalculated from transit depth or from the published planet and stellar radii. A warning is shown in the NEA status line."/>
            <TextBlock TextWrapping="Wrap" Margin="40,2,0,0" Text="• Rp/Rs Uncertainty — computed alongside the substituted Rp/Rs value (propagated from transit depth uncertainty or planet/stellar radius uncertainties). If no source uncertainty is available, it is estimated at 10% of the substituted value."/>
            <TextBlock TextWrapping="Wrap" Margin="40,2,0,0" Text="• a/Rs Uncertainty — set to 0.1 when not reported."/>
            <TextBlock TextWrapping="Wrap" Margin="40,2,0,0" Text="• Star Metallicity [Fe/H] and its uncertainties — set to 0.0 ± 0.1 (solar) when not reported."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" Text="Whenever any of these defaults are applied, a notification dialog appears immediately after the NEA fetch listing exactly which values were estimated. You can dismiss the dialog and then edit any field directly on the Equipment &amp; Target tab before clicking Save &amp; Run. Always replace estimated values with published data if it is available."/>
            <TextBlock TextWrapping="Wrap" Text="• When the plate solve completes, the Fetch Comps button in the Star Selection section becomes active. Select a comparison star method from the dropdown (AAVSO VSP, VSP + Stone, or Stone) — a description of each method appears and updates dynamically as you change the selection — then click Fetch Comps. The selected method is remembered between sessions. Stars within 5% of the frame border or within 30 arcseconds of the target are excluded. A Cancel button appears during the fetch. A status line shows the current stage and final result:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="⟳  Stone method: querying Gaia DR3…  (live stage label while running)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Foreground="{StaticResource BrushOk}"  Text="✓  N comp stars — VSP + Stone (M VSP, N Stone) | mags: … | PSF: …"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Foreground="{StaticResource BrushErr}" Text="✗  No candidates found  (use manual methods below)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Foreground="{StaticResource BrushWarn}" Text="⚠  Skipped — fetch planet parameters first"/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="• When the Stone or VSP + Stone method is running, a step-by-step report streams into the Results tab log in real time (all 8 pipeline stages: Gaia query, VSP, APASS, frame projection, scoring, GSPC, PSF validation, and target PSF). After the query completes, an Image Quality panel appears below the status bar with four indicators:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="FWHM — mean FWHM across selected comp stars with uniformity label (uniform / mild / significant)."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Color match — 'active' when the target's Gaia BP-RP index was found; enables the 30% color-similarity scoring component."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Precision — photon-limited photometric precision in mmag, estimated from the target star's PSF SNR (1000 / SNR)."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="PSF grade — overall quality of the field: good / acceptable / marginal / poor (color-coded green/yellow/orange/red)."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="• Buttons in the Star Selection section:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Retry Plate Solve  — visible when a plate solve has failed or been cancelled. Click to re-attempt without re-reading the FITS header."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Fetch Comps  — active once WCS is ready. Click to run the selected comparison star method. Click again at any time to re-run (e.g. after changing the planet name or method)."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Cancel  — visible while a comp fetch is in progress. Stops the current fetch immediately."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="• Comp star method selector — three options:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="AAVSO VSP"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Queries the AAVSO Variable Star Plotter for this field's vetted comparison stars. Fast and reliable when an AAVSO sequence exists. Only stars with published photometry in your observation filter's VSP band are returned — a chart star with no entry in that band is skipped, since it can't be used to calibrate that filter. No PSF validation."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="VSP + Stone  (recommended)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Full pipeline named after Geoffrey Stone (CompStarSelector). Queries Gaia DR3, APASS DR9, Gaia GSPC synthetic photometry, and AAVSO VSP. VSP stars fill the first available slots; the Stone pipeline (Gaia + APASS) fills any remaining slots up to the configured maximum (1–25, default 10, set via Tools → Settings → Comp Stars). Comp stars are scored by color similarity to the target (BP-RP index), magnitude, flux SNR, RUWE astrometric quality, and centrality. Quality gates: RUWE uses a tiered fallback — &lt; 1.1 preferred, relaxing to &lt; 1.2 then &lt; 1.4 on sparse fields (minimum 8 candidates required to accept a stricter tier); Gaia flux-over-error &gt; 200 (stars with lower SNR in the Gaia catalog are excluded as marginal); AAVSO VSX cross-check removes any candidate matching a known variable in the Variable Star Index (complementary to Gaia's own variability flag — a star can be in VSX without being flagged in Gaia DR3). PSF validation with up to 3 backfill passes rejects stars that are saturated, have SNR &lt; 75, an elongated PSF, or an outlier FWHM — a rejected VSP star's slot is refilled from another VSP candidate first if one is available, so VSP stars stay ahead of Stone stars even after backfill. Magnitude sources: GSPC (~0.01 mag) → APASS (~0.03 mag) → Gaia G→V polynomial → VSP."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Stone"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,4,0" Text="Same as VSP + Stone but without the AAVSO VSP query. Useful when no AAVSO sequence exists for the target or you prefer a purely catalog-driven selection."/>

            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="• Additional star selection methods:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Auto Select Target"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Uses the target's RA/Dec (from Planet Parameters) and the WCS in the plate-solved FITS to compute the exact pixel position instantly."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Pick Target Star  (Image Analysis tab)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="If plate solving fails (e.g. sparse star field or poor WCS coverage), Auto Select Target cannot compute the target position. Use Pick Target Star instead: open the Image Analysis tab, click Pick Target Star, click the target in the image, then click Send to Target Star."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Pick Comp Stars  (Image Analysis tab)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Click stars directly in the image viewer — useful when other methods fail."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,12" Text="• All comp methods stack — duplicates removed, total capped at the configured maximum (see Tools → Settings → Comp Stars, default 10)."/>

            <!-- ── 4. Image Analysis tab ─────────────────────────────────────── -->
            <TextBlock x:Name="Sec4" Classes="h2" Text="4.  Image Analysis tab" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• When the Lights Directory is set on the Data tab, Image Analysis automatically scans and flags files using the last-used σ threshold. Flagged frames are NOT automatically excluded — use 'Exclude Flagged' to exclude them all, or check individual Excl boxes manually."/>
            <TextBlock TextWrapping="Wrap" Text="• Click Scan Files at any time to re-scan (e.g. after changing the threshold). The status bar shows 'Scanning N / N…' while scanning is underway."/>
            <TextBlock TextWrapping="Wrap" Text="• The Background column shows each frame's median pixel value (ADU), sampled across the image for speed. Frames whose background exceeds the set σ threshold above the session median are flagged in red."/>
            <TextBlock TextWrapping="Wrap" Text="• Adjust the σ threshold to control flagging sensitivity (default 3 σ). The threshold value is remembered between sessions."/>
<TextBlock TextWrapping="Wrap" Text="• Click any column header to sort the list; click again to reverse."/>
            <TextBlock TextWrapping="Wrap" Text="• Click any filename to preview the image. The first image viewed auto-stretches to a 0.5–99.5 percentile range automatically."/>
            <TextBlock TextWrapping="Wrap" Text="• The histogram below the image shows the pixel value distribution of the current frame. The red line marks the black point and the cyan line marks the white point."/>
            <TextBlock TextWrapping="Wrap" Text="• Black/White sliders: use +/− buttons to step 1 ADU per click (hold for auto-repeat), or drag the slider. Once you manually adjust either level, those settings are locked and carry over when you click other frames — click Auto Stretch to reset to an automatic 0.5–99.5 percentile stretch (and re-enable auto-stretch for subsequent frames)."/>
            <TextBlock TextWrapping="Wrap" Text="• Move the mouse over the image to see the X/Y pixel coordinates and ADU value displayed below the stretch sliders."/>
            <TextBlock TextWrapping="Wrap" Text="• Zoom: use the Zoom + / Zoom − buttons or scroll the mouse wheel over the image. Click Reset to return to the fit-to-viewer zoom."/>
            <TextBlock TextWrapping="Wrap" Text="• Pop Out (next to Auto Stretch): opens the image viewer — zoom, pan, cursor readout, picking, stretch sliders, everything — in its own separate, resizable window, handy on a small laptop screen. The frame list stays in the main window, so you can keep selecting frames while looking at the bigger popped-out view. Close the pop-out window (its own X, or the Bring Back button shown in its place on the tab) to return it to the tab."/>
            <TextBlock TextWrapping="Wrap" Text="• Pan: click and drag the image with the left mouse button to reframe."/>
            <TextBlock TextWrapping="Wrap" Text="• Pick Target Star / Pick Comp Stars: click either button to enter pick mode, then click a star in the image. A red crosshair marks the target; each comp star gets a numbered cyan circle. All markers stay anchored to the correct pixel through any zoom or pan. Click Send to Target Star or Send to Comp Stars to transfer the coordinates to the Equipment &amp; Target tab. Picks must be made on the first non-excluded image (the one EXOTIC uses as its alignment reference) — if you click Pick on any other frame a dialog will remind you to navigate to the first image."/>
            <TextBlock TextWrapping="Wrap" Text="• VSP Chart row (second control row) — downloads and displays an AAVSO Variable Star Plotter chart for the target. Set FOV′ (arcminutes) and Mag limit, then type the host star name in the Star field (e.g. HAT-P-36) and click VSP Chart. The Star field auto-fills when planet parameters are fetched from NEA, so no FITS header is needed to view the chart. The chart window is non-modal — you can continue using the app while it is open."/>
            <TextBlock TextWrapping="Wrap" Text="• Dark-subtract before background estimate — when checked, the launcher loads all FITS files in the Darks directory, averages them into a master dark, and subtracts it from each science frame before computing the background value used for flagging."/>
            <TextBlock TextWrapping="Wrap" Text="• The status row below the scan controls shows two counters: images excluded and images flagged. The flagged counter turns yellow when one or more frames are flagged."/>
            <TextBlock TextWrapping="Wrap" Text="• Check the Excl column to mark images for exclusion. Scanning flags images automatically but does NOT check Excl — use Auto-exclude Flagged to check all flagged images at once, or tick boxes individually. Unchecking removes the mark immediately with no re-scan needed."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="How exclusion works: the Excl checkbox is an in-memory flag only — no files are moved when you check or uncheck it. When Save &amp; Run is clicked, any images still marked Excl are physically moved aside so EXOTIC cannot see them. After EXOTIC finishes they are moved back automatically."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="When Save &amp; Run is clicked with one or more images marked Excl, a confirmation dialog lists every excluded image by number and filename. Click Proceed to continue or Cancel to adjust. No dialog appears when nothing is excluded."/>
            <TextBlock TextWrapping="Wrap" Text="• Click Restore Excluded to un-check all Excl boxes in the current list. This does not move any files — it simply clears all exclusion marks so every image will be included in the next run." Margin="0,0,0,12"/>

            <!-- ── 4a. Visualizer tab ─────────────────────────────────────────── -->
            <TextBlock x:Name="SecVis" Classes="h2" Text="5.  Visualizer tab" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="The Visualizer tab shows a real-time animated transit simulation. It loads initial values from the planet parameters on the Parameters tab (Rp/Rs, a/Rs, Inclination, Orbital Period), but any changes made in the Visualizer are local to the Visualizer — they do not write back to the Parameters tab. Use the Visualizer to explore 'what-if' scenarios freely without disturbing your saved parameters."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,4" FontWeight="SemiBold" Text="Geometry panel (left)"/>
            <TextBlock TextWrapping="Wrap" Text="• The target/planet name is shown at the top of the panel and updates automatically when you change the planet name or host star name on the Parameters tab."/>
            <TextBlock TextWrapping="Wrap" Text="• The star color adapts to the host star's effective temperature (Teff). Hot A/F stars (Teff &gt; 7500 K) appear white-blue; solar-type G stars yellow; K-type orange; M-type red-orange. Enter Teff on the Parameters tab to see the correct color. Solar-yellow is used as the default when Teff is not entered."/>
            <TextBlock TextWrapping="Wrap" Text="• The star is rendered with a limb-darkening radial gradient, faculae patches, and sunspots. Concentric glow rings around the star are labelled 'Limb darkening'."/>
            <TextBlock TextWrapping="Wrap" Text="• The planet appearance adapts to its estimated size class (based on Rp/Rs). Gas giants (k ≥ 0.09) show atmospheric banding with a storm oval. Neptune-class (k 0.05–0.09) show teal-blue banding. Small/rocky planets (k &lt; 0.05) appear grey-blue."/>
            <TextBlock TextWrapping="Wrap" Text="• The orbital chord (dashed line) shows the path the planet centre traces across or near the stellar disk. The planet moves left to right."/>
            <TextBlock TextWrapping="Wrap" Text="• T₁ and T₄ tick marks (first and fourth contact) are placed at the planet's edge position at the moment of contact — the tick aligns with the star's limb rather than the planet's center. T₂ and T₃ (inner boundary of full overlap) are shown for non-grazing transits only."/>
            <TextBlock TextWrapping="Wrap" Text="• The dashed orange line shows the impact parameter b — the projected perpendicular distance from the star's centre to the transit chord in stellar radii."/>
            <TextBlock TextWrapping="Wrap" Text="• The planet is shown in full color during transit and fades to near-invisible when behind the star."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,4" FontWeight="SemiBold" Text="Light curve panel (right)"/>
            <TextBlock TextWrapping="Wrap" Text="• Shows flux (normalised stellar brightness) vs. hours from mid-transit, computed using a quadratic limb-darkened transit model. Out of transit flux is 1.0; the transit appears as a downward dip."/>
            <TextBlock TextWrapping="Wrap" Text="• The display window spans ±1.5×T₁₄ around mid-transit (total 3×T₁₄), keeping the transit event prominent."/>
            <TextBlock TextWrapping="Wrap" Text="• The red cursor line tracks the current orbital phase. The time offset from mid-transit is shown to the left of the cursor and the current flux value to the right, both at the top of the cursor. The transit depth Δ = …% is displayed directly beneath the trough of the light curve (at mid-transit)."/>
            <TextBlock TextWrapping="Wrap" Text="• Load Photometry… — click to import observed photometry data and overlay it on the model light curve. Supported formats: AAVSO EXOTIC output files (.txt with TYPE=EXOPLANET header) and generic two-column CSV files (phase, flux). AAVSO files use BJD_TDB dates; the launcher automatically converts them to phase using Tc and Period from the file header. Observed data points are shown as yellow dots; a legend appears in the upper-right corner. Import a new file or close and re-open the tab to clear the overlay."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,4" FontWeight="SemiBold" Text="Animation controls"/>
            <TextBlock TextWrapping="Wrap" Text="• Play / Pause — starts or pauses the animation. The transit (T₁₄ duration) always takes approximately 8 seconds at Speed 1×."/>
            <TextBlock TextWrapping="Wrap" Text="• Reset — stops playback and jumps back to just before ingress (T₁)."/>
            <TextBlock TextWrapping="Wrap" Text="• Speed slider — scales animation speed from 0.2× to 5×."/>
            <TextBlock TextWrapping="Wrap" Text="• Orbit slider — drag to manually scrub the planet to any orbital phase (0–1, where 0.5 = mid-transit). Works while the animation is playing or paused. The phase readout (φ = …) updates in real time."/>
            <TextBlock TextWrapping="Wrap" Text="• Auto-loop: after egress the animation holds at T₄ for 1.5 seconds, then jumps back to pre-ingress and continues automatically."/>
            <TextBlock TextWrapping="Wrap" Text="• Parameters ▶ button — opens the Visualizer Parameters sandbox window. Sliders here control what the animation displays; they do not affect the Parameters tab. Available controls:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Rp/Rs — planet-to-star radius ratio (sets transit depth and planet size)."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Inclination — orbital inclination in degrees. Changing inclination moves the transit chord vertically and automatically updates the Impact Parameter b display."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Impact Param b — the projected distance of the transit chord from the star's centre in stellar radii. Coupled to Inclination: dragging b recalculates the inclination angle and vice versa. Dragging a/Rs keeps inclination fixed and adjusts b accordingly."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="a/Rs — orbital semi-major axis in stellar radii (affects transit duration and impact parameter)."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="u₁, u₂ — quadratic limb darkening coefficients. u₁ controls the linear darkening toward the limb; u₂ controls the quadratic curvature. Hover each slider for typical values by spectral type. These shape the rounded bottom of the transit light curve."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Reset — restores all sandbox sliders to the current values from the Parameters tab."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,4" FontWeight="SemiBold" Text="Starspot Effect (Visualizer Parameters)"/>
            <TextBlock TextWrapping="Wrap" Text="The Starspot Effect section at the bottom of the Visualizer Parameters popup lets you place a simulated dark spot on the stellar disk and observe how it modifies the light curve. This feature is purely educational — it demonstrates the physical phenomena using well-established models."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Enable checkbox"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4" Text="Turns the spot on or off. When disabled, the sliders are greyed out and the light curve is unaffected."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4" FontWeight="SemiBold" Text="Spot radius (stellar radii)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4" Text="Sets the spot's radius on the projected stellar disk, in units of the stellar radius (0.01–0.30). Larger values cover more of the disk and produce a deeper baseline depression."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4" FontWeight="SemiBold" Text="ΔT — temperature contrast (K)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4" Text="How many kelvins cooler the spot is than the surrounding photosphere (0–2000 K). The flux contrast is computed via the Stefan-Boltzmann law: contrast = 1 − (T_spot / T_phot)⁴. Typical solar sunspots are 1000–2000 K cooler than the photosphere. The host star's effective temperature (Teff from the Parameters tab) is used for T_phot."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4" FontWeight="SemiBold" Text="Spot X, Spot Y (stellar radii)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4" Text="Position of the spot centre on the projected stellar disk, in stellar radii (−0.9 to +0.9). X is the horizontal axis; Y is vertical. To generate an in-transit bump, place the spot on the transit chord: set Y equal to the impact parameter b and move X into the transit path. A spot away from the chord produces only a baseline depression with no bump."/>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,4" FontWeight="SemiBold" Text="Light curve effects"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Unocculted spot (Zellem et al. 2017, ApJ 844, 1) — a dark spot anywhere on the visible disk slightly lowers the out-of-transit baseline below 1.0. This is because the star is intrinsically fainter than it would be without the spot, so the normalised flux appears slightly depressed at all orbital phases."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="In-transit spot bump (Silva 2003, A&amp;A 400, 723) — when the planet passes in front of the spot it occludes a region that is already darker than the surrounding photosphere. Because the planet is blocking less light than it would over the normal photosphere, the measured flux briefly rises relative to the surrounding transit depth — producing a characteristic bump in the light curve."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="The direction of the bump is counterintuitive: even though the transit makes the star dimmer, an in-transit spot bump appears as a local increase in flux (brightness) within the dip, not an additional deepening. This is a well-known diagnostic used in real exoplanet photometry to infer starspot properties from the shape and timing of anomalies in transit light curves."/>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Classes="hint" FontStyle="Italic" Text="Note: the starspot model in TransitLab is an educational approximation. It assumes a circular spot with uniform brightness deficit, a point-source planet, and ignores limb-angle corrections to the spot contrast (beyond the local limb-darkening intensity evaluated at the spot centre). Real starspot modelling involves additional free parameters and degeneracies. The references shown in About TransitLab describe the underlying physical models."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,4" FontWeight="SemiBold" Text="Derived quantities bar (bottom)"/>
            <TextBlock TextWrapping="Wrap" Text="• Impact Param b, Transit Depth, T₁₄ (full duration), T₂₃ (flat-bottom duration), Stellar Density, and Spectral Type are shown below the panels and update automatically. T₂₃ reads 'Grazing' for grazing transits. Stellar density is expressed in solar units (ρ★/ρ☉) and is derived from a/Rs and the orbital period. Spectral type is inferred from Teff (O through M/L-T) with a brief description." Margin="0,0,0,12"/>

            <!-- ── 5. Menu Bar ────────────────────────────────────────────────── -->
            <TextBlock x:Name="Sec5" Classes="h2" Text="6.  Menu Bar" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• The menu bar sits at the very top of the window and is always accessible regardless of which tab is active."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="File menu"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Load previous inits.json…  — loads a prior config to re-populate all fields."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Save inits.json Only  — saves without launching (useful for review before running)."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Import AAVSO Report (-pre)…  — re-fit a previously-produced AAVSO_&lt;planet&gt;_&lt;date&gt;.txt report (the Exoplanet Watch format, not the plain AAVSO database file) via EXOTIC's -pre mode, with no FITS files, comp star selection, or plate solve needed. The orbital solution (period, Rp/Rs, a/Rs, inclination, eccentricity, mid-transit time) is recovered exactly from the file's own embedded metadata; only stellar Teff/logg/FeH (needed solely for limb-darkening) come from a fresh NASA Exoplanet Archive lookup. Output goes into its own pre_import_&lt;timestamp&gt; folder next to the source file — the original file is never overwritten. Requires a file with EXOTIC's newer #PRIORS-XC/#RESULTS-XC metadata block; older reports without it can't be re-imported this way."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Recent Sessions  — hover to see the last 10 runs; click any entry to reload it instantly."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Tools menu"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Clear All Fields  — resets all fields to defaults for a fresh session."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Python &amp; EXOTIC Setup  — opens the Python and EXOTIC installation wizard (see section 9)."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Plate Solve Setup  — opens the plate solver configuration dialog (see section 10)."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Clear ldtk Cache  — deletes EXOTIC's local limb-darkening model cache (~/.ldtk). Always safe to use — the cache is automatically rebuilt as needed on the next EXOTIC run. Use this if a run fails with an 'Empty or corrupt FITS file' error, which usually means a previous download into this cache was interrupted and left a truncated file behind."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Download Full ldtk Library  — downloads and installs the complete PHOENIX limb-darkening model library directly into ~/.ldtk over HTTPS, so every model file EXOTIC could ever need is already on disk. The total download size (several GB) is shown for confirmation before anything is downloaded."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" FontStyle="Italic" Text="What are these files, and why cache them locally? Before EXOTIC can fit a transit light curve, it needs limb-darkening coefficients for the host star — a description of how the star's disk dims toward its edge, which depends on the star's effective temperature, surface gravity, and metallicity. EXOTIC gets these from ldtk, a Python library that looks up the matching PHOENIX stellar-atmosphere model FITS files and computes the coefficients from them. By default ldtk fetches these files one target at a time from an FTP server in Göttingen, Germany — a connection that some networks (particularly certain Mac firewalls and hotel/campus/observatory Wi-Fi) block or time out on, causing a run to fail partway through. Caching the files locally in ~/.ldtk removes this dependency entirely: once a file has been downloaded (via 'Clear ldtk Cache' + a normal run, via the automatic HTTPS fallback below, or via 'Download Full ldtk Library'), EXOTIC reads it straight from disk on every future run for any target that needs it — faster, reproducible, and immune to that server being slow, blocked, or temporarily down."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,12" FontStyle="Italic" Text="Automatic HTTPS fallback: if EXOTIC's FTP connection to the limb-darkening server times out mid-run, TransitLab detects the failure, fetches just the files needed for that target over HTTPS instead, and automatically retries the run — no manual intervention needed. This matters most for EXOTIC 4.3.1, which has no fallback of its own if the FTP server is unreachable."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Diagnostics  — opens the current session log in a live-updating scrollable viewer. The log captures startup, every EXOTIC output line, plate solve and AAVSO results, NEA queries, and any errors or warnings from any part of the app. Use this window to diagnose problems or to share a log with support. Click Save Log… to export the log as a .txt file, or click ⏸ Pause to freeze the view while new entries arrive."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Settings  — opens the Settings dialog. Completion Sound: choose from Tada, Chime, or Ding (built-in Windows sounds), None (silent), or Custom… (browse for a WAV, MP3, or AIFF file on your computer). Click Test to preview the selected sound before saving."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Help menu"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Quick Start  — a concise 7-step guide for new users. Start here."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="User Guide  — opens this window."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Revision History  — shows what changed in each version."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Check for Updates  — manually checks for a newer version of TransitLab. If an update is available, a banner appears at the top of the window with Download and Skip options. TransitLab also checks automatically each time it starts."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Submit Feedback  — opens the feedback form to submit a bug report or feature request (see section 13)."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,12" Text="About TransitLab  — version, author, acknowledgements, and release-of-liability notice."/>

            <!-- ── 6. Save & Run EXOTIC ─────────────────────────────────────── -->
            <TextBlock x:Name="Sec6" Classes="h2" Text="7.  Save &amp; Run EXOTIC" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• Save &amp; Run EXOTIC and Cancel are in the top bar, always visible:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Save &amp; Run EXOTIC  — saves inits.json then launches EXOTIC. Clicking the button always switches to the Results tab. If a new FITS directory was browsed but Read FITS Header has not been clicked, an explanatory dialog appears and the run is blocked until the header is read."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="⏹ Cancel  — appears while EXOTIC is running; click to abort."/>
            <TextBlock TextWrapping="Wrap" Text="• inits.json is saved to the Save Plots directory."/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="• EXOTIC runs inside the launcher — no separate console window opens. Output is streamed live to the Results tab. The launcher stays open and responsive while EXOTIC runs."/>

            <!-- ── 7. Results tab ────────────────────────────────────────────── -->
            <TextBlock x:Name="Sec7" Classes="h2" Text="8.  Results tab" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• The Results tab opens automatically when EXOTIC starts running."/>
            <TextBlock TextWrapping="Wrap" Text="• ⏸ Pause Log button — toggles auto-scroll. When active, the log stops scrolling so you can read output while EXOTIC is still running. Click again to resume auto-scroll. The button is in the top-right corner of the log panel."/>
            <TextBlock TextWrapping="Wrap" Text="• The Auto / Manual prompts toggle (next to the EXOTIC Log label) controls how EXOTIC's mid-run questions are handled:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Auto prompts (default)  — known prompts are answered automatically: secondary observer codes are sent from the launcher form, and 'Enter 1 or 2' (use your defined parameters vs. review NEA differences) always answers 1. All other unexpected prompts are still surfaced to you."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Manual prompts  — every question EXOTIC asks appears in the input box below the log window. Type your response and press Enter or click Send. Use this mode if you want to review NEA parameter differences individually during a run."/>
            <TextBlock TextWrapping="Wrap" Text="• The top section streams EXOTIC's live log output with colour coding:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Foreground="{StaticResource BrushOk}"  Text="Green  — success messages and final parameters"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Foreground="{StaticResource BrushWarn}" Text="Amber  — warnings (e.g. missing calibration files)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Foreground="{StaticResource BrushErr}" Text="Red    — errors"/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="• When EXOTIC finishes, the light curve plot is displayed automatically in the centre panel."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="EXOTIC fits the light curve using nested sampling (Ultranest or Dynesty) — a Bayesian method that maps the full probability distribution of each parameter rather than finding a single best-fit value. The result is a range of plausible solutions; EXOTIC reports the median and 1σ credible interval. Tighter, cleaner data produces narrower intervals and more consistent results; noisier data produces wider intervals."/>
            <TextBlock TextWrapping="Wrap" Text="• The lower panel provides direct upload to AAVSO:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Login"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Enter your AAVSO username and password and click Login. Tick 'Save password' to remember it between sessions."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="AAVSO Exoplanet  (exosite)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="The report file and light curve image are detected automatically. Select Site and Equipment Package, tick 'I accept the GDPR terms', then click Upload to AAVSO Exoplanet. A confirmed upload is recorded automatically in the History tab."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="WebObs AID"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="The AID file is detected automatically. Click Open WebObs in Browser to go directly to the AAVSO WebObs upload page. WebObs requires manual review and approval of the data before final submission."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Transit Post Generator"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,12" Text="Click Open Transit Post Generator to open the Exoplanet Slacker website, where you can create a formatted Slack/Discord post from your results. (Douglas James &amp; Exoplanet Slacker)"/>

            <!-- ── 8. History tab ────────────────────────────────────────────── -->
            <TextBlock x:Name="Sec8" Classes="h2" Text="9.  History tab" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• The History tab keeps a permanent record of every accepted AAVSO Exoplanet submission, stored in submission_history.json next to config.json. This file is preserved across rebuilds."/>
            <TextBlock TextWrapping="Wrap" Text="• A row is added automatically after each successful upload. Columns: Planet, Obs, Obs Date, Submitted, Tmid (BJD_TDB) ± uncertainty, (Rp/R*)² ± uncertainty, SNR, Depth %, Inc °, Duration, Scatter %."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Obs Date is derived automatically from the Tmid BJD_TDB value."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="SNR = (Rp/R*)² ÷ ±(Rp/R*)² — a quality indicator; &gt;8 is a well-detected transit."/>
            <TextBlock TextWrapping="Wrap" Text="• Click any column header to sort; click again to reverse. Column widths can be resized by dragging — widths are saved automatically."/>
            <TextBlock TextWrapping="Wrap" Text="• Editing records:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Double-click any row to open an edit dialog and correct any field."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Add Entry — opens a blank dialog for a manual entry."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Delete Selected — removes the highlighted row permanently."/>
            <TextBlock TextWrapping="Wrap" Text="• Importing data:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Import FinalParams JSON… — browse to any FinalParams_*.json from a previous EXOTIC run. Numeric fields are pre-filled; Planet and Observatory are left blank."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Import CSV/XLSX… — restore history from a previously exported file. Duplicate rows (matched by planet + obs date + Tmid) are skipped."/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="• Download CSV / Download XLSX — export the full history table. XLSX includes a formatted navy header row and auto-sized columns."/>

            <!-- ── 9. Python & EXOTIC Setup ──────────────────────────────────── -->
            <TextBlock x:Name="Sec9" Classes="h2" Text="10.  Python &amp; EXOTIC Setup  (Tools → Python &amp; EXOTIC Setup)" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• The Python &amp; EXOTIC Setup wizard walks you through installing, updating, or repairing Python and EXOTIC. Open it from Tools → Python &amp; EXOTIC Setup in the menu bar."/>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,4" FontStyle="Italic" Text="Linux note: Python must be installed manually before using this wizard. Open a terminal and run:  sudo apt-get install python3.10 python3.10-venv python3.10-distutils  — then click Check System. All other setup steps work the same once Python is detected."/>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,4" Text="• Python version requirement (Stable): EXOTIC officially supports Python 3.8–3.10. Python 3.11 and above are not officially supported and may not work correctly. Python 3.10.11 is recommended. If Check System detects an unsupported version, a warning dialog will appear. The Pre-release card has its own, separate Python requirement — see below."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Check System"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Scans for an existing Python installation (≥ 3.8) and checks whether EXOTIC is installed. Shows the detected version and path for each. This row is used only to build the Stable environment — run this first to enable Stable's Install / Reinstall button. Pre-release has its own separate Check System button on its own card, further down."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Download &amp; Install Python  /  Reinstall Python  (Windows and macOS only)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Downloads the Python 3.10.11 installer to your Temp folder (progress bar shown) and runs a silent installation. This button is always enabled after Check System runs. Its label changes to 'Reinstall Python' when Python is already detected — use it to repair a corrupt or broken Python installation without affecting EXOTIC or other packages. Not available on Linux. This is Stable's Python only — see the Pre-release card below for its own Python 3.12 install button."/>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,4" Text="• EXOTIC Environments (since v2.8.0): Stable and Pre-release / Development Build each have their own card below the Python row. Each is installed into its own isolated Python virtual environment, so both can be installed at once — you no longer need to uninstall one to use the other. The radio button (●) on a card selects which environment runs when you click Save &amp; Run EXOTIC; switching is instant, no reinstall needed."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Stable card — Install / Reinstall, Uninstall, Remove"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Install / Reinstall creates (on first use) an isolated virtual environment and installs the official released EXOTIC into it via pip, streaming the full output to the log box. Uninstall removes EXOTIC from that environment but keeps the virtual environment itself, so reinstalling later is fast. Remove deletes the environment folder entirely. Enabled once Python is detected."/>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold" Text="Pre-release / Development Build card"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="The EXOTIC developers occasionally publish test builds to a specific GitHub branch before they are included in an official release. If directed to test one, paste the GitHub URL in the format  https://github.com/rzellem/EXOTIC.git@branch-name  (remembered in the dropdown for next time) and click Install / Reinstall. TransitLab checks whether Git is installed on your machine and installs it automatically (via winget) if it is not. A UAC elevation prompt may appear — click Yes to allow it. Uninstall and Remove work the same as on the Stable card."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Pre-release requires its own Python 3.12 or higher — some pre-release branches now declare this requirement in their own package metadata, which Stable's Python 3.10 can't satisfy. The card has its own Check System and Download &amp; Install Python 3.12 buttons, entirely separate from Stable's Python row above — install Python 3.12 here first if it isn't already detected, before Install / Reinstall on this card. If an existing Pre-release environment was built from an older Python that no longer meets this requirement, Install / Reinstall automatically rebuilds it fresh from the currently detected Python 3.12 the next time it's clicked — no manual removal needed."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4" Classes="hint" Text="Pre-release builds are not officially supported and may produce unexpected results. Use only when directed by the EXOTIC developers."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Classes="hint" Text="If you install one environment while the other still shows the older shared (non-isolated) install, a note appears on the Setup tab suggesting you install that one too if you want both fully separated. This is only a suggestion — TransitLab never installs or reinstalls an environment automatically."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,4" Text="• When EXOTIC is successfully found or installed, its path is saved automatically and the launcher uses it immediately — no restart required."/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="• Setup activity is automatically recorded in the session log — use Tools → Diagnostics to view and save the full log."/>

            <!-- ── 10. Plate Solve Setup ─────────────────────────────────────── -->
            <TextBlock x:Name="Sec10" Classes="h2" Text="11.  Plate Solve Setup  (Tools → Plate Solve Setup)" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• Open from Tools → Plate Solve Setup. This dialog configures how the launcher plate-solves your FITS images to obtain sky coordinates (WCS). Plate solving is required for automatic target and comparison star selection."/>
            <TextBlock TextWrapping="Wrap" Text="• Three solvers are available. Select one using the radio buttons at the top of the dialog:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Astrometry.net  (default)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Uses EXOTIC's built-in astrometry.net integration to submit the image to the online plate-solving service. Requires EXOTIC to be installed and an active internet connection. No additional configuration is needed — this is the default."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="ASTAP  (local, offline)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="ASTAP (Astrometric STAcking Program) is a free local solver that runs entirely on your machine. It is much faster than astrometry.net and works without an internet connection or EXOTIC installation. It must be downloaded and configured separately."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="NextAstro  (online, experimental)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Uses NextAstronomy's own hosted astrometry service instead of astrometry.net. Rather than uploading the full FITS image, it detects stars locally first and sends only their pixel coordinates and brightness — a much smaller upload — along with the target's RA/Dec and pixel scale as hints to speed up and improve the match. This solver is only available in the EXOTIC 4.3.2 pre-release dev build (Tools → Python &amp; EXOTIC Setup → Pre-release / Development Build, see section 10) — it is not yet part of any official EXOTIC release."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="TransitLab checks your installed EXOTIC version automatically each time this dialog opens and only enables this option when the required pre-release build is detected (reported as '4.3.2.dev…' rather than a plain '4.3.2'). Otherwise it is greyed out with a note explaining the requirement, so it can no longer be selected by mistake on a stable EXOTIC install."/>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,4" FontWeight="SemiBold" Text="Setting up ASTAP:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Step 1 — Download and install ASTAP"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Click the link button in the dialog to open the ASTAP download page (hnsky.org/astap.htm). Download the Windows installer and run it. The default install location is C:\Program Files\astap\."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Step 2 — Download a star catalog"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="ASTAP requires a star catalog to solve images. On the same download page, download one of the available catalogs — the H17 (280 MB) or D80 (500 MB) are recommended for most use cases and work well for typical exoplanet fields. Run the catalog installer; it installs the catalog files into the ASTAP program folder by default."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Step 3 — Configure the path in the launcher"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="In the Plate Solve Setup dialog, click Auto-detect — the launcher checks C:\Program Files\astap\ automatically for astap_cli.exe (preferred) or astap.exe. If ASTAP is installed elsewhere, click Browse… to navigate to the executable. The Catalog Folder field is optional — leave it blank if your catalog files are in the same folder as the executable."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Step 4 — Test"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Click Test. If ASTAP is found, the detected version appears and the catalog status lists which catalog files were located. A green status means ASTAP is ready."/>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" Text="ASTAP options:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" Text="• Search Radius (arcminutes, 10–600, default 60ʹ) — how wide an area ASTAP searches when solving. If your FITS header contains approximate coordinates from the telescope pointing model, 60ʹ (1°) is usually sufficient. If solving fails or your header coordinates are unreliable, try increasing this value."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="• Downsample (default 0 = auto) — reduces image size before solving. Leave at 0 unless solving is very slow on your machine; auto lets ASTAP choose the optimal setting for your image size."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="• Solve ALL images — when checked, clicking Plate Solve solves every FITS file in your FITS directory (not just the first one), regardless of which solver is selected. Useful when WCS coordinates are needed on all frames. Default is off (solve first image only)."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="• Solve ALL images with Astrometry.net or NextAstro: each frame is solved with its own network round-trip to a hosted solver, rather than ASTAP's instant local solve — a full directory can take noticeably longer. Checking Solve ALL images with an online solver selected (or switching to one while it's already checked) shows a one-time warning that this may take a while; the solve still runs, it just needs more patience for a full night's worth of frames."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="• While solving all images, the live status line shows a running count ('Solving 45/92… (12 solved, 33 failed so far)') rather than naming individual failing frames — on data where many frames are expected to fail (e.g. MicroObservatory images at ASTAP's small-image-dimensions limit), the final result is what matters, not every frame along the way. Once finished, the status color tells you what to do next: green (✓) means every frame solved with no errors; yellow (⚠) means some frames failed but the scan is still usable — EXOTIC only needs one solved reference frame, so you can proceed; red (✗) means zero frames solved and the data can't be used as-is — switch solvers or check the FITS files."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="• ASTAP struggles with data from certain sources — if TransitLab recognizes the FITS header as MicroObservatory or Unistellar eVscope data while ASTAP is selected, a warning appears before the solve starts, recommending Astrometry.net or NextAstro instead. For MObs, the issue is small image dimensions. For Unistellar, testing against real eVscope frames found that ASTAP still fails to solve even after debayering with a correct pixel scale — the scope's own field distortion is likely the cause, and it's not something debayering or a scale correction alone can fix. Astrometry.net solved the same debayered frames successfully."/>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,12" Text="• Note: 'Warning scale was inaccurate!' is a normal ASTAP success message, not an error. It means ASTAP detected that the actual field of view differs slightly from what the FITS header indicated — the solve succeeded and WCS was written to the file. The launcher displays 'ASTAP plate solve complete — WCS written to FITS.' for any successful ASTAP solve. The active solver is shown on the Equipment &amp; Target tab (e.g. 'Solver: ASTAP')."/>

            <!-- ── 11. Settings ───────────────────────────────────────────────── -->
            <TextBlock x:Name="Sec11" Classes="h2" Text="12.  Settings  (Tools → Settings)" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="The Settings menu (Tools → Settings) contains three items: Notifications (section 13), Comp Stars (section 13a), and Automation (section 14). Each opens its own dedicated window." Margin="0,0,0,12"/>

            <!-- ── 11a. Notifications ─────────────────────────────────────────── -->
            <TextBlock x:Name="Sec11a" Classes="h2" Text="13.  Notifications" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="Access via Tools → Settings → Notifications. Configure the sounds TransitLab plays when operations complete." Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4" FontWeight="SemiBold" Text="Completion sound"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,8" Text="Choose from three built-in Windows sounds (Tada, Chime, Ding), silence (None), or a custom audio file from your computer (WAV, MP3, or AIFF). Click Test to preview the selected sound before saving. The default is Tada."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4" FontWeight="SemiBold" Text="Operation status alerts"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,8" Text="When enabled, TransitLab plays a short Windows Device Connect sound on success or a Device Disconnect sound on failure after each of these operations: NEA target fetch, plate solve, and AAVSO comparison star fetch. Enabled by default; toggle off if you find the sounds distracting."/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4" FontWeight="SemiBold" Text="Show tips at startup"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,12" Text="When enabled, a Tip of the Day popup appears each time TransitLab starts, cycling through 47 tips covering every area of the app. Use Prev/Next in the popup to browse. Uncheck 'Show tips at startup' in the popup itself, or toggle it off here, to disable. Re-enable at any time by turning this toggle back on."/>

            <!-- ── 11a. Comp Stars ──────────────────────────────────────────── -->
            <TextBlock x:Name="Sec11a2" Classes="h2" Text="13a.  Comp Stars" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="Access via Tools → Settings → Comp Stars." Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,4" FontWeight="SemiBold" Text="Max comparison stars"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,12" Text="Sets the maximum number of comparison stars selected by all comp methods (1–25, default 10). Raising this above 10 is only beneficial when the quality gates (RUWE, FOE, SNR) are tight enough that additional candidates are genuinely better than the current ensemble average. The active limit is shown in the Stone pipeline log header on the Results tab."/>

            <!-- ── 11b. Automation ────────────────────────────────────────────── -->
            <TextBlock x:Name="Sec11b" Classes="h2" Text="14.  Automation" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="The Automation feature lets TransitLab process a completed observation session automatically — without you needing to be at your computer. Set a FITS folder and a start time, arm it, and TransitLab will run the full preparation and reduction pipeline at the scheduled time."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" Text="What it does"/>
            <TextBlock TextWrapping="Wrap" Text="At the configured start time, TransitLab runs this sequence automatically:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="1.  Sets the FITS Files Directory to the configured folder."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="2.  Clears the Darks Directory and disables Dark Subtract — calibrated input images do not need an additional dark correction."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="3.  Scans all FITS files in the folder. If no non-excluded frames remain after the next step, the sequence aborts and reports a warning — check the Flag Sigma setting."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="4.  Auto-excludes any flagged frames (same as clicking Exclude Flagged on the Image Analysis tab)."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="5.  Reads the FITS header from the first non-excluded file, then waits for the plate solve (WCS) and NASA Exoplanet Archive (NEA) parameter fetch to both complete — up to 5 minutes. When both finish, observation date, coordinates, equipment, and all planetary parameters are populated."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="6.  Auto-selects the target star pixel position using the WCS plate solution and the target RA/Dec from NEA."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="7.  Waits for the AAVSO comparison star fetch to complete, then auto-selects comparison stars (up to the 10-star EXOTIC maximum). If 10 comp stars are already selected from a previous session, they are cleared automatically so a fresh selection can be made."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="8.  Saves inits.json and launches EXOTIC — producing the light curve. All confirmation dialogs are automatically accepted during an automation run."/>
            <Border BorderThickness="1" BorderBrush="{StaticResource BrushWarn}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap" Text="Note: AAVSO upload is not part of the automated sequence. After automation completes, you should open the Results tab, review the light curve and residuals carefully, and — if the data quality meets the AAVSO submission standards — log in and submit manually. Automated upload is intentionally omitted because the quality of each dataset must be assessed by the observer before submission."/>
            </Border>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" Text="Configuring Automation"/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="FITS folder"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="Browse to the folder containing the calibrated FITS files to be processed."/>
            <TextBlock TextWrapping="Wrap" Margin="20,4,0,0" FontWeight="SemiBold" Text="Start time (HH:MM)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,0,0,0" Text="The 24-hour wall-clock time at which the sequence fires. Set this to after your calibration is expected to finish — for example, if imaging until 05:00 AM and calibration takes ~30 minutes, enter 05:30. Leave blank to start immediately when you click Arm."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" Text="Before arming — verify these fields"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="• Flag Sigma  (Image Analysis tab)  — controls which frames are auto-excluded. The default of 3.0 excludes frames more than 3 standard deviations from the median background. Increase it to be more permissive, decrease to be stricter. If Flag Sigma is too strict, all frames may be excluded and the sequence will abort."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="• Observer Code  (Parameters tab)  — your AAVSO observer code. Required for valid inits.json output and AAVSO submission."/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" Text="Arming and disarming"/>
            <TextBlock TextWrapping="Wrap" Text="• Click Arm in Tools → Settings → Automation to start the countdown. A flashing green 'AUTOMATION ARMED' banner appears above the tab strip, with a MM:SS countdown to the start time. The Automation window status line also shows the current state."/>
            <TextBlock TextWrapping="Wrap" Text="• The Automation window can be closed after arming — the countdown continues running in the background. Reopen it at any time to check the current status or disarm."/>
            <TextBlock TextWrapping="Wrap" Text="• Click Disarm at any time to cancel. The sequence will not run if disarmed before the start time." Margin="0,0,0,12"/>

            <!-- ── 12. Diagnostics ───────────────────────────────────────────── -->
            <TextBlock x:Name="Sec12" Classes="h2" Text="15.  Diagnostics  (Tools → Diagnostics)" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• Every time TransitLab runs it creates a timestamped log file named TransitLab_diagnostics_YYYYMMDD_HHmmss.log, in %AppData%\TransitLab\logs\ on Windows or ~/.config/TransitLab/logs/ on Mac and Linux. The five most recent session logs are kept; older ones are deleted automatically."/>
            <TextBlock TextWrapping="Wrap" Text="• Open Tools → Diagnostics to view the current session log in a scrollable window that updates in real time as new events occur — no Refresh button needed. Log entries include:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="[Startup]  — app version and launch time"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="[Config]  — whether config.json loaded successfully or fell back to defaults"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="[FITS]  — which file was read, errors if the file was unreadable, or 'no FITS files found'"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="[NEA]  — the planet name queried, whether it was found, any defaults applied"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="[PlateSolve]  — ✓ or ✗ per frame for both Astrometry.net and ASTAP; all-frames summary"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="[AavsoComp]  — number of comparison stars loaded, or the reason none were found"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="[AAVSO Login]  — the username, sites and equipment found on the account, and login result"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="[AAVSO Upload]  — upload success or failure message"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="[Run]  — the planet name, FITS directory, and inits.json path when Save &amp; Run is clicked; any validation failures"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="[EXOTIC]  — every line of EXOTIC's live output"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="[Setup]  — Python &amp; EXOTIC Setup wizard activity (install, reinstall, uninstall steps, version found)"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="[History]  — errors when loading, saving, importing, or exporting history records"/>
            <TextBlock TextWrapping="Wrap" Text="• ⏸ Pause button — freezes the display so you can read entries while new ones continue to arrive in the background. Lines that arrive while paused are held in a buffer and flushed when you click Pause again to resume. (This is the same Pause pattern used in the EXOTIC Log on the Results tab.)"/>
            <TextBlock TextWrapping="Wrap" Text="• Load Previous Log button — opens a file picker starting directly in the logs folder (%AppData%\TransitLab\logs\ on Windows, ~/.config/TransitLab/logs/ on Mac and Linux) so you can select any saved session log without navigating there manually. Once loaded, the log title above the viewer updates to show the filename and the live feed is paused so current-session entries do not mix in. Save Log… works on the loaded file just as it does for the current session."/>
            <TextBlock TextWrapping="Wrap" Text="• Save Log… button — saves the entire log as a plain-text .txt file. Use this when sharing a problem report with support."/>
            <TextBlock TextWrapping="Wrap" Text="• If another user reports a problem (e.g. missing sites in the AAVSO dropdown), ask them to open Tools → Diagnostics after reproducing the issue and use Save Log… to send the file. The [AAVSO Login] entries will list exactly which sites and equipment IDs the server returned, making remote diagnosis straightforward without needing to inspect network traffic." Margin="0,0,0,12"/>

            <!-- ── 13. Previous Versions ────────────────────────────────────── -->
            <TextBlock x:Name="Sec13" Classes="h2" Text="16.  Previous Versions  (Help → Previous Versions)" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• Opens a window listing every TransitLab release on GitHub, showing the version number, release date, and the ZIP asset available for your platform (win-x64, osx-arm64, or linux-x64)."/>
            <TextBlock TextWrapping="Wrap" Text="• Select any release and click Download to save the ZIP to a folder of your choice. Extract the ZIP to replace your current installation."/>
            <TextBlock TextWrapping="Wrap" Text="• Releases that do not have an asset built for your platform are shown in the list but the Download button is disabled for them."/>
            <TextBlock TextWrapping="Wrap" Text="• Your settings (config.json) and submission history (history.json) are stored in %AppData%\TransitLab\ on Windows or ~/.config/TransitLab/ on Mac and Linux, and are not affected by switching versions." Margin="0,0,0,12"/>

            <!-- ── 14. Bug Reports ───────────────────────────────────────────── -->
            <TextBlock x:Name="Sec14" Classes="h2" Text="17.  Submit Feedback  (Help → Submit Feedback)" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• Use Help → Submit Bug Report / Feature Request to send feedback directly to the TransitLab GitHub repository."/>
            <TextBlock TextWrapping="Wrap" Text="• Fill in the form fields:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Type  — choose Bug Report or Feature Request."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Summary  — a short one-line description (optional but recommended)."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Description  — describe the issue or request in detail. Required before submitting."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Contact email  — required. You will be contacted here if follow-up is needed."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="Version and OS are filled in automatically."/>
            <TextBlock TextWrapping="Wrap" Text="• Click Submit Report. A confirmation message appears when the report is received."/>
            <TextBlock TextWrapping="Wrap" Text="• After submitting, please email your diagnostics log to art.trail@icloud.com so the issue can be investigated. To save the log: Tools → Diagnostics → Save Log."/>
            <TextBlock TextWrapping="Wrap" Text="• Reports are submitted to a public GitHub repository and are visible to anyone. Do not include passwords or sensitive personal information." Margin="0,0,0,12"/>

            <!-- ── Tips ──────────────────────────────────────────────────────── -->
            <TextBlock x:Name="SecTips" Classes="h2" Text="Tips" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="→  MObs workflow: Fetch List → select → Download → Use This Data → Read FITS Header → proceed."/>
            <TextBlock TextWrapping="Wrap" Text="→  Read FITS Header fills most fields automatically — always run it first."/>
            <TextBlock TextWrapping="Wrap" Text="→  All directories and observer settings persist between sessions."/>
            <TextBlock TextWrapping="Wrap" Text="→  Darks, Flats, Biases, and Save Plots directories (Data tab) each default to the Lights directory when they don't already have a directory of their own — each can still be browsed to a different location independently. The Diagnostics → Save Log dialog remembers its own separate last-used folder."/>
            <TextBlock TextWrapping="Wrap" Text="→  Plate solving starts automatically when Read FITS Header is clicked. Once WCS is ready, select a comp method and click Fetch Comps."/>
            <TextBlock TextWrapping="Wrap" Text="→  For MicroObservatory (MObs) data (650×500, 5&quot;/px) or Unistellar eVscope data, use Astrometry.net or NextAstro instead of ASTAP — MObs images are too small for ASTAP's quad-matching, and Unistellar frames have a field distortion ASTAP can't solve even after debayering. TransitLab will tell you if this is the problem."/>
            <TextBlock TextWrapping="Wrap" Text="→  If TransitLab detects raw one-shot-color (Bayer pattern) data when you set a Lights/Darks/Flats/Biases directory, debayer it when prompted — Image Analysis, Plate Solve, and comp star selection all give better results on debayered data, not just Plate Solve."/>
            <TextBlock TextWrapping="Wrap" Text="→  Planet names are auto-corrected: case, hyphens (HATP→HAT-P), spacing (WASP-160B→WASP-160 B), and planet letter appended if missing."/>
            <TextBlock TextWrapping="Wrap" Text="→  File → Recent Sessions is the fastest way to reload a previous night's setup."/>
            <TextBlock TextWrapping="Wrap" Text="→  In Image Analysis and History, sort any column by clicking its header."/>
            <TextBlock TextWrapping="Wrap" Text="→  Remember to restore excluded files before starting a new EXOTIC session."/>
            <TextBlock TextWrapping="Wrap" Text="→  SNR in the History tab = (Rp/R*)² divided by its uncertainty — values above ~8 indicate a well-detected transit."/>
            <TextBlock TextWrapping="Wrap" Text="→  Use the Search box at the top of this guide to find any topic instantly. Press Enter or click Find Next to cycle through all matches."/>

            <!-- ── Appendix — Filter Wavelength Reference Sources ─────────────── -->
            <TextBlock x:Name="SecAppA" Classes="h2" Text="Appendix — Filter Wavelength Reference Sources" Margin="0,12,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="• The Filter Minimum/Maximum Wavelength auto-fill table (keyed by AAVSO filter code — see 'Filter Name (aavso.org/filters)' on the Parameters tab) is a built-in reference of typical bandpass values, not a live measurement of your specific filter. Where each value came from:"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="— Johnson-Cousins U, B, V, R, I: computed as (effective wavelength ± FWHM/2) from Bessell, M.S. 1990, PASP, 102, 1181, the standard reference for this photometric system. Confirmed by direct calculation — TransitLab's V and R ranges match Bessell's published figures exactly; U, B, and I are within ~0.4 nm."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="— Sloan SU, SG, SR, SI, SZ: computed the same way (effective wavelength ± FWHM/2) from Fukugita, M. et al. 1996, AJ, 111, 1748, the SDSS photometric system paper. TransitLab's SU range matches Fukugita's published effective wavelength almost exactly; the others track within a few nm."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="— CV, CBB, L, N/A, Y and similar 'Clear'/broadband designations: engineering estimates, not derived from a published bandpass. AAVSO's own current filter-code reference — The AAVSO Guide to CCD/CMOS Photometry with Monochrome Cameras (2022) — defines what comparison-star magnitude system each code should be calibrated against (e.g. 'CV: Clear (unfiltered) using V-band comp star magnitudes'), but explicitly does not (and, by its own explanation, cannot) publish a fixed numeric bandpass for a Clear filter, since that depends entirely on the camera's own sensor response rather than a fixed piece of glass."/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Text="— Stromgren (STU/STV/STB/STY/STHBW/STHBN), NIR (J/H/K), Optec Wing (MA/MB/MI), and RJ/IJ: not independently re-verified against a named source — treat these as reasonable estimates rather than confirmed literature values."/>
            <TextBlock TextWrapping="Wrap" Text="• Bottom line: always confirm Filter Minimum/Maximum Wavelength against your own filter's actual published bandpass before running EXOTIC, especially for Clear-type filters." Margin="0,0,0,12"/>

            <!-- ── References ────────────────────────────────────────────────── -->
            <TextBlock x:Name="SecRefs" Classes="h2" Text="References" Margin="0,16,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="Software, services, and published sources TransitLab relies on or integrates with directly. Section-specific sources (filter wavelength defaults, Visualizer starspot models) are also cited inline where they're used; see the Appendix above and the Visualizer section." Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="[1] Zellem, R. T., Pearson, K. A., Blaser, E., et al. 2020, Publications of the Astronomical Society of the Pacific, 132 — EXOTIC, the reduction pipeline TransitLab launches and streams output from. github.com/rzellem/EXOTIC"/>
            <TextBlock TextWrapping="Wrap" Text="[2] NASA Exoplanet Archive, operated by the California Institute of Technology under contract with NASA's Exoplanet Exploration Program — source of planetary and stellar parameters (Fetch from NEA). exoplanetarchive.ipac.caltech.edu"/>
            <TextBlock TextWrapping="Wrap" Text="[3] AAVSO — American Association of Variable Star Observers. VSP comparison-star charts, Exoplanet Watch submission format, and WebObs AID upload. aavso.org"/>
            <TextBlock TextWrapping="Wrap" Text="[4] Gaia Collaboration, Vallenari, A., Brown, A. G. A., et al. 2023, &quot;Gaia Data Release 3: Summary of the content and survey properties,&quot; Astronomy &amp; Astrophysics, 674, A1 — Gaia DR3, one of the Stone/VSP + Stone comp-star magnitude and astrometric quality sources."/>
            <TextBlock TextWrapping="Wrap" Text="[5] APASS — AAVSO Photometric All-Sky Survey, another Stone/VSP + Stone comp-star magnitude source. aavso.org/apass"/>
            <TextBlock TextWrapping="Wrap" Text="[6] Geoffrey Stone, CompStarSelector — the comparison-star vetting approach the Stone and VSP + Stone methods are named after and modeled on. github.com/geofstone/exotic-proto"/>
            <TextBlock TextWrapping="Wrap" Text="[7] ASTAP (Astrometric STAcking Program), Han Kleijn — one of TransitLab's four plate solvers. hnsky.org/astap.htm"/>
            <TextBlock TextWrapping="Wrap" Text="[8] Lang, D., Hogg, D. W., Mierle, K., Blanton, M., &amp; Roweis, S. 2010, The Astronomical Journal, 139, 1782 — Astrometry.net, the online blind-astrometry service EXOTIC uses as TransitLab's default plate solver."/>
            <TextBlock TextWrapping="Wrap" Text="[9] StarFix — a separate, first-party local Gaia DR3 plate solver, one of TransitLab's four plate-solver options. github.com/ArtTrail/StarFix"/>
            <TextBlock TextWrapping="Wrap" Text="[10] MicroObservatory Robotic Telescope Network — telescope data mirrored via the Data tab's MObs section. microobservatory.org"/>
            <TextBlock TextWrapping="Wrap" Text="[11] Mandel, K., &amp; Agol, E. 2002, &quot;Analytic Light Curves for Planetary Transit Searches,&quot; The Astrophysical Journal, 580, L171 — the quadratic limb-darkened transit model behind the Visualizer's light curve."/>
            <TextBlock TextWrapping="Wrap" Text="[12] Bessell, M. S. 1990, Publications of the Astronomical Society of the Pacific, 102, 1181 — source for the Johnson-Cousins U/B/V/R/I filter wavelength defaults (see Appendix)."/>
            <TextBlock TextWrapping="Wrap" Text="[13] Fukugita, M., Ichikawa, T., Gunn, J. E., et al. 1996, The Astronomical Journal, 111, 1748 — source for the Sloan filter wavelength defaults (see Appendix)."/>
            <TextBlock TextWrapping="Wrap" Text="[14] Zellem et al. 2017, The Astrophysical Journal, 844, 1 — unocculted-starspot baseline depression model (Visualizer Starspot Effect)."/>
            <TextBlock TextWrapping="Wrap" Text="[15] Silva, A. V. R. 2003, Astronomy &amp; Astrophysics, 400, 723 — in-transit starspot flux-bump model (Visualizer Starspot Effect)." Margin="0,0,0,12"/>

            <Border Height="60"/>

        </StackPanel>

    </ScrollViewer>

    <Button Classes="fab" Content="&#x2191;" Click="OnBackToTopClick" ToolTip.Tip="Back to top"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28"/>
    </Grid>

</UserControl>
