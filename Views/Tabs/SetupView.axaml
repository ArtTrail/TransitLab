<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TransitLab.ViewModels"
             x:DataType="vm:ExoticSetupViewModel"
             x:Class="TransitLab.Views.Tabs.SetupView">

    <DockPanel Margin="16,10,16,10">

        <!-- ── Headline ─────────────────────────────────────────────────────── -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding HeadlineText}"
                   Classes="hint"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <!-- ── Shared Cancel (each card now has its own Check System / Reinstall
             Python; only one operation runs at a time, so a single Cancel serves both.
             The status of both cards is detected automatically when this window opens). -->
        <WrapPanel DockPanel.Dock="Top"
                   Orientation="Horizontal"
                   Margin="0,0,0,8">
            <Button Classes="toolbar" Margin="0,0,0,4"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding CanCancel}"
                    Foreground="{StaticResource BrushErr}"
                    ToolTip.Tip="Stops the operation currently running — a Python download/install, an EXOTIC install, or a version check. Enabled only while something is running; since only one operation runs at a time, this single button covers both cards."/>
        </WrapPanel>

        <!-- ── EXOTIC environments: Stable and Pre-release side by side ────────
             Each is an isolated install (its own Python venv) so both can stay
             installed at once — switching is just picking which one runs next. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="EXOTIC Environments"
                       FontWeight="SemiBold"/>
            <Button Content="[?]" FontSize="12" Padding="3,0" Margin="8,0,0,0"
                    VerticalAlignment="Center" Click="OnHelpEnvironments_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Classes="hint"
                   Text="The active environment (●) is what runs when you click Save &amp; Run. Install, reinstall, or remove either one independently — no need to uninstall one to use the other."
                   Margin="0,0,0,8"/>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,10,*" Margin="0,0,0,8">

            <!-- Stable card -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BrushSep}"
                    CornerRadius="4"
                    Padding="10,8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton IsChecked="{Binding StableIsActive}"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="Use Stable for the next run"/>
                        <TextBlock Text="Stable" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding StableStatusIcon}"
                                   Foreground="{Binding StableStatusIcon, Converter={StaticResource StatusBrushConverter}}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StableStatusText}"
                                   Classes="hint"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Stable's own base Python (independent of Pre-release's — Stable
                         releases run on 3.10–3.12). Detected automatically on open; the
                         buttons below re-scan or install a fresh copy. -->
                    <Border BorderThickness="1"
                            BorderBrush="{StaticResource BrushSep}"
                            CornerRadius="4"
                            Padding="8,6">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="16,Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding PythonStatusIcon}"
                                           Foreground="{Binding PythonStatusIcon, Converter={StaticResource StatusBrushConverter}}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Python:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding PythonStatus}"
                                           Classes="hint"
                                           Foreground="{Binding PythonStatus, Converter={StaticResource StatusBrushConverter}}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="toolbar" Margin="0,0,8,4"
                                        Content="Check System"
                                        Command="{Binding CheckSystemCommand}"
                                        IsEnabled="{Binding CanCheck}"
                                        ToolTip.Tip="Re-scans for a Python 3.10–3.12 interpreter for Stable EXOTIC (4.3.1) and refreshes the Stable environment's status. Both cards are detected automatically when this window opens."/>
                                <Button Classes="toolbar" Margin="0,0,0,4"
                                        Content="{Binding GetPythonLabel}"
                                        Command="{Binding GetPythonCommand}"
                                        IsEnabled="{Binding CanGetPython}"
                                        IsVisible="{Binding IsNotLinux}"
                                        ToolTip.Tip="Downloads and installs Python 3.10.11 from python.org — the recommended version for Stable EXOTIC (4.3.1). Use it if no Python was found, or to repair a corrupt one. This installs Python only; it doesn't touch EXOTIC or your other packages."/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="toolbar" Margin="0,0,8,4"
                                Content="Install Environment"
                                Command="{Binding InstallStableCommand}"
                                IsEnabled="{Binding StableCanInstall}"
                                ToolTip.Tip="Creates an isolated environment if needed, then installs EXOTIC into it. Clicking again fully reinstalls EXOTIC in place — this is how you repair a corrupted install. Your system Python is never modified."/>
                        <Button Classes="toolbar" Margin="0,0,8,4"
                                Content="Uninstall EXOTIC 4.3.1"
                                Command="{Binding UninstallStableCommand}"
                                IsEnabled="{Binding StableCanUninstall}"
                                ToolTip.Tip="Removes only the EXOTIC package (the 4.3.1 release). The environment itself is kept, so a later Install Environment is quick."/>
                        <Button Classes="toolbar" Margin="0,0,0,4"
                                Content="Delete Environment"
                                Command="{Binding RemoveStableCommand}"
                                IsEnabled="{Binding StableCanRemove}"
                                IsVisible="{Binding StableHasVenv}"
                                Foreground="{StaticResource BrushErr}"
                                ToolTip.Tip="Deletes this entire isolated environment — EXOTIC and its Python. Use this if the environment itself is broken; a later Install Environment rebuilds it from scratch."/>
                    </WrapPanel>
                    <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,8,0,0"
                               IsVisible="{Binding StableIsBasePython}"
                               Text="EXOTIC is currently installed in your system Python. Click Install Environment to move it into an isolated environment — your system Python won't be modified, and this becomes the recommended, self-contained setup."/>
                </StackPanel>
            </Border>

            <!-- Pre-release card -->
            <Border Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BrushWarn}"
                    CornerRadius="4"
                    Padding="10,8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton IsChecked="{Binding PrereleaseIsActive}"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="Use Pre-release for the next run"/>
                        <TextBlock Text="Pre-release / Development Build" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding PrereleaseStatusIcon}"
                                   Foreground="{Binding PrereleaseStatusIcon, Converter={StaticResource StatusBrushConverter}}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PrereleaseStatusText}"
                                   Classes="hint"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap"
                               Classes="hint"
                               Text="Install directly from a GitHub branch. Use only when directed by the EXOTIC developers to test a specific branch — not officially supported and may produce unexpected results."/>

                    <!-- Pre-release's own base Python (independent of Stable's, above — some
                         branches require a newer Python than Stable's releases do). -->
                    <Border BorderThickness="1"
                            BorderBrush="{StaticResource BrushSep}"
                            CornerRadius="4"
                            Padding="8,6">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="16,Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding PrereleasePythonStatusIcon}"
                                           Foreground="{Binding PrereleasePythonStatusIcon, Converter={StaticResource StatusBrushConverter}}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Python:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding PrereleasePythonStatus}"
                                           Classes="hint"
                                           Foreground="{Binding PrereleasePythonStatus, Converter={StaticResource StatusBrushConverter}}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="toolbar" Margin="0,0,8,4"
                                        Content="Check System"
                                        Command="{Binding CheckPrereleasePythonCommand}"
                                        IsEnabled="{Binding CanCheck}"
                                        ToolTip.Tip="Searches for a Python 3.12+ interpreter, used only to create this environment — independent of Stable's Python in its own card."/>
                                <Button Classes="toolbar" Margin="0,0,0,4"
                                        Content="{Binding PrereleaseGetPythonLabel}"
                                        Command="{Binding GetPrereleasePythonCommand}"
                                        IsEnabled="{Binding PrereleaseCanGetPython}"
                                        IsVisible="{Binding IsNotLinux}"
                                        ToolTip.Tip="Downloads and installs Python 3.12.10 from python.org — used only to build the Pre-release environment (some dev branches require 3.12+, which Stable's Python can't satisfy). Use it if no 3.12 was found, or to repair a corrupt one. Installs Python only; it doesn't touch EXOTIC."/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding BranchUrls}"
                                  Text="{Binding BranchUrl}"
                                  IsEditable="True"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                                Classes="toolbar"
                                Content="Remove URL"
                                Command="{Binding RemoveBranchUrlCommand}"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap"
                               Classes="hint"
                               Text="e.g. https://github.com/rzellem/EXOTIC.git@branch-name — remembered in the dropdown above."/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="toolbar" Margin="0,0,8,4"
                                Content="Check Dev Version"
                                Command="{Binding CheckPrereleaseVersionCommand}"
                                IsEnabled="{Binding CanCheckPrereleaseVersion}"
                                ToolTip.Tip="Checks the branch's latest commit against what's installed in the Pre-release environment, without reinstalling. Just needs a branch URL entered above (pre-filled with the default dev branch)."/>
                        <Button Classes="toolbar" Margin="0,0,8,4"
                                Content="Uninstall EXOTIC 4.3.2"
                                Command="{Binding UninstallPrereleaseCommand}"
                                IsEnabled="{Binding PrereleaseCanUninstall}"
                                ToolTip.Tip="Removes only the EXOTIC package (the 4.3.2 dev build). The environment itself is kept, so a later Install Environment is quick."/>
                        <Button Classes="toolbar" Margin="0,0,8,4"
                                Content="Install Environment"
                                Command="{Binding InstallBranchCommand}"
                                IsEnabled="{Binding CanInstallBranch}"
                                ToolTip.Tip="Creates this environment if needed, then installs or reinstalls EXOTIC from the branch URL above. Safe to click even if already installed — this is how you pull in the branch's latest commit without uninstalling first."/>
                        <Button Classes="toolbar" Margin="0,0,0,4"
                                Content="Delete Environment"
                                Command="{Binding RemovePrereleaseCommand}"
                                IsEnabled="{Binding PrereleaseCanRemove}"
                                IsVisible="{Binding PrereleaseHasVenv}"
                                Foreground="{StaticResource BrushErr}"
                                ToolTip.Tip="Deletes this entire isolated environment — EXOTIC and its Python. Use this if the environment itself is broken; a later Install Environment rebuilds it from scratch."/>
                    </WrapPanel>
                    <TextBlock TextWrapping="Wrap"
                               Classes="hint"
                               IsVisible="{Binding PrereleaseVersionCheckStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding PrereleaseVersionCheckStatus}"
                               Foreground="{Binding PrereleaseVersionCheckStatus, Converter={StaticResource StatusBrushConverter}}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Progress bar ─────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsProgressVisible}"
                Margin="0,0,0,8">
            <StackPanel Spacing="4">
                <ProgressBar Value="{Binding ProgressValue}"
                             Maximum="{Binding ProgressMax}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Height="10"/>
                <TextBlock Classes="hint"
                           Text="{Binding ProgressText}"
                           HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- ── Log output ────────────────────────────────────────────────────── -->
        <TextBox x:Name="LogBox"
                 Text="{Binding LogText}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                 FontSize="22"
                 Background="{StaticResource BrushField}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 MinHeight="100"
                 VerticalAlignment="Stretch"/>

    </DockPanel>

</UserControl>
