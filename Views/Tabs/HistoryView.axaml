<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TransitLab.ViewModels"
             x:Class="TransitLab.Views.Tabs.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <DockPanel Margin="10,8,10,8">

        <!-- ── Button bar ────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,6" Background="Transparent">
            <StackPanel Orientation="Horizontal">
                <Button Content="[?]" FontSize="12" Padding="3,0"
                        VerticalAlignment="Center" Margin="0,0,6,0"
                        Click="OnHelpHistory_Click"/>
                <Button Classes="toolbar"
                        Content="Export CSV"
                        Command="{Binding DownloadCsvCommand}"
                        Margin="0,0,6,0"/>
                <Button Classes="toolbar"
                        Content="Export XLSX"
                        Command="{Binding DownloadXlsxCommand}"
                        Margin="0,0,6,0"/>
                <Button Classes="toolbar"
                        Content="Delete Selected"
                        Command="{Binding DeleteSelectedCommand}"
                        Margin="0,0,6,0"/>
                <Button Classes="toolbar"
                        Content="Import FinalParams JSON…"
                        Command="{Binding ImportJsonCommand}"
                        Margin="0,0,6,0"/>
                <Button Classes="toolbar"
                        Content="Import CSV / XLSX…"
                        Command="{Binding ImportFileCommand}"
                        Margin="0,0,12,0"/>
                <TextBlock Classes="hint"
                           Text="Records accepted by AAVSO Exoplanet submissions."
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Separator ────────────────────────────────────────────────────── -->
        <Rectangle DockPanel.Dock="Top"
                   Height="1"
                   Fill="{StaticResource BrushSep}"
                   Margin="0,0,0,6"/>

        <!-- ── History DataGrid ──────────────────────────────────────────────── -->
        <DataGrid x:CompileBindings="False"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  Background="Transparent"
                  RowBackground="Transparent"
                  SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Planet"         Binding="{Binding Planet}"       SortMemberPath="Planet"       Width="Auto"/>
                <DataGridTextColumn Header="Obs"            Binding="{Binding Obs}"          SortMemberPath="Obs"          Width="Auto"/>
                <DataGridTextColumn Header="Obs Date"       Binding="{Binding ObsDate}"      SortMemberPath="ObsDateSort"  Width="Auto"/>
                <DataGridTextColumn Header="Submitted"      Binding="{Binding SubmittedStr}" SortMemberPath="Submitted"    Width="Auto"/>
                <DataGridTextColumn Header="Tmid (BJD_TDB)" Binding="{Binding Tmid}"         SortMemberPath="TmidSort"     Width="Auto"/>
                <DataGridTextColumn Header="±Tmid"          Binding="{Binding TmidUnc}"      SortMemberPath="TmidUncSort"  Width="Auto"/>
                <DataGridTextColumn Header="(Rp/R*)²"       Binding="{Binding RpRs}"         SortMemberPath="RpRsSort"     Width="Auto"/>
                <DataGridTextColumn Header="±(Rp/R*)²"      Binding="{Binding RpRsUnc}"      SortMemberPath="RpRsUncSort"  Width="Auto"/>
                <DataGridTextColumn Header="SNR"            Binding="{Binding Snr}"          SortMemberPath="SnrSort"      Width="Auto"/>
                <DataGridTextColumn Header="Depth %"        Binding="{Binding Depth}"        SortMemberPath="DepthSort"    Width="Auto"/>
                <DataGridTextColumn Header="Inc °"          Binding="{Binding Inc}"          SortMemberPath="IncSort"      Width="Auto"/>
                <DataGridTextColumn Header="Dur (d)"        Binding="{Binding Duration}"     SortMemberPath="DurationSort" Width="Auto"/>
                <DataGridTextColumn Header="Scatter %"      Binding="{Binding Scatter}"      SortMemberPath="ScatterSort"  Width="Auto"/>
            </DataGrid.Columns>

        </DataGrid>

    </DockPanel>

</UserControl>
