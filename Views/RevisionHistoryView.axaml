<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TransitLab.Views.RevisionHistoryView"
             x:CompileBindings="False">

    <!--
      Data-driven from Services/RevisionHistoryData.cs (RevisionHistoryData.All) — the single
      source of truth also used by the "What's New" first-launch popup (MainWindow.axaml.cs,
      ShowWhatsNewAsync), so the two can never drift apart. Add a new version's entries there,
      not here.
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">

        <ItemsControl x:Name="VersionsList" Margin="32,20,32,24">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="6" Margin="0,0,0,12">
                        <TextBlock Classes="h2" Text="{Binding Header}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Bullets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding}" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </ScrollViewer>

</UserControl>
