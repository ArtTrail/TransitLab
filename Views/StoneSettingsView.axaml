<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TransitLab.ViewModels"
             x:DataType="vm:StoneSettingsViewModel"
             x:Class="TransitLab.Views.StoneSettingsView">

    <StackPanel Margin="28,24,28,20" Spacing="16" MinWidth="380">

        <!-- Comp star limit -->
        <Grid ColumnDefinitions="*,12,Auto,8,Auto">
            <TextBlock Grid.Column="0"
                       Text="Max comparison stars"
                       VerticalAlignment="Center"
                       ToolTip.Tip="Maximum comparison stars selected by all comp methods (AAVSO VSP, VSP + Stone, and Stone). Raising this above 10 only improves results when quality gates (RUWE, FOE, SNR) are tight enough that additional candidates are genuinely better than the current ensemble average."
                       ToolTip.ShowDelay="500"/>
            <NumericUpDown Grid.Column="2"
                           Value="{Binding MaxCompStars}"
                           Minimum="1"
                           Maximum="25"
                           Increment="1"
                           Width="120"
                           FormatString="0"/>
            <TextBlock Grid.Column="4"
                       Text="(1 – 25)"
                       VerticalAlignment="Center"
                       Classes="hint"/>
        </Grid>

        <Rectangle Height="1" Fill="{StaticResource BrushSep}" Margin="0,4,0,0"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    MinWidth="80"/>
            <Button Content="Save"
                    Classes="primary"
                    Command="{Binding SaveCommand}"
                    MinWidth="80"/>
        </StackPanel>

    </StackPanel>

</UserControl>
